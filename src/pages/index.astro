---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Frise from '../components/Frise.astro';
import Carrousel from '../components/Carrousel.astro';
import Icone from '../components/Icone.astro';
import { profil, parcours, competences } from '../data/profil';

const travaux = (await getCollection('travaux')).sort(
  (a, b) => b.data.annee - a.data.annee || b.data.debut - a.data.debut,
);

const elementsFrise = travaux.map((t) => ({
  id: t.id,
  titre: t.data.titre,
  nature: t.data.nature,
  debut: t.data.debut,
  fin: t.data.fin,
  enCours: t.data.enCours,
}));

// Initiales pour le médaillon, quand il n'y a pas de portrait
const initiales = profil.nom
  .split(/\s+/)
  .map((m) => m[0])
  .join('');

const enRomain = (n: number) => {
  const table: [number, string][] = [
    [1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'], [100, 'C'], [90, 'XC'],
    [50, 'L'], [40, 'XL'], [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
  ];
  let s = '';
  for (const [v, c] of table) while (n >= v) { s += c; n -= v; }
  return s;
};
const annee = new Date().getFullYear();

// Repères de navigation sur le côté de l'écran
const ecrans = [
  { id: 'accueil', nom: 'Introduction' },
  { id: 'chronologie', nom: 'Chronologie' },
  { id: 'travaux', nom: 'Travaux' },
  { id: 'competences', nom: 'Compétences' },
  { id: 'contact', nom: 'Contact' },
];
---

<Base>
  <nav class="reperes" aria-label="Sections de la page">
    <ol>
      {
        ecrans.map((e, i) => (
          <li>
            <a href={`#${e.id}`} data-ecran={e.id}>
              <span class="repere-nom">{e.nom}</span>
              <span class="repere-num">{enRomain(i + 1)}</span>
              <span class="repere-trait" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <!-- I. Introduction -->
  <section id="accueil" class="ecran ouverture" aria-labelledby="nom">
    <div class="contenu ouverture-grille" data-reveal>
      <div class="ouverture-texte">
        <p class="surtitre">Portfolio · Histoire</p>
        <p class="script-intro" aria-hidden="true">Introduction</p>
        <h1 id="nom">{profil.nom}</h1>
        <div class="filet"></div>
        <p class="statut">{profil.statut}</p>
        <p class="presentation">{profil.presentation}</p>
        <div class="actions">
          <a class="bouton bouton-plein" href="#travaux">Découvrir mes travaux</a>
          <a class="bouton" href={profil.cv} download>Télécharger le CV</a>
        </div>
      </div>

      <div class="medaillon" aria-hidden={profil.portrait ? undefined : 'true'}>
        <div class="medaillon-cadre">
          {
            profil.portrait ? (
              <img src={profil.portrait} alt={`Portrait de ${profil.nom}`} />
            ) : (
              <div class="monogramme">
                <span class="initiales">{initiales}</span>
                <span class="devise">
                  {profil.ville} · {enRomain(annee)}
                </span>
              </div>
            )
          }
        </div>
      </div>
    </div>

    <a class="defiler" href="#chronologie">
      <span>Défiler</span>
      <span class="defiler-trait" aria-hidden="true"></span>
    </a>
  </section>

  <!-- II. Chronologie -->
  <section id="chronologie" class="ecran" aria-label="Chronologie">
    <div class="contenu">
      <Frise travaux={elementsFrise} parcours={parcours} />
    </div>
  </section>

  <!-- III. Travaux -->
  <Carrousel travaux={travaux} />

  <!-- IV. Compétences -->
  <section id="competences" class="ecran competences-ecran" aria-labelledby="titre-competences">
    <div class="contenu">
      <div class="competences-entete" data-reveal>
        <p class="surtitre">Savoir-faire</p>
        <h2 id="titre-competences" class="titre-section">Compétences</h2>
        <div class="filet filet-centre"></div>
      </div>
      <ul class="competences">
        {
          competences.map((c, i) => (
            <li class="competence" data-reveal style={`--delai: ${(i % 4) * 110}ms`}>
              <span class="niche" aria-hidden="true">
                <Icone nom={c.icone} />
              </span>
              <span class="competence-nom">{c.nom}</span>
              {c.detail && <span class="competence-detail">{c.detail}</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- V. Contact -->
  <section id="contact" class="ecran contact" aria-labelledby="titre-contact">
    <div class="contenu" data-reveal>
      <p class="surtitre">Correspondance</p>
      <h2 id="titre-contact" class="titre-section">Écrivez-moi</h2>
      <div class="filet filet-centre"></div>
      <p class="courriel">
        <a href={`mailto:${profil.email}`}>{profil.email}</a>
      </p>
      <ul class="liens">
        <li><a class="bouton" href={profil.cv} download>CV (PDF)</a></li>
        {
          profil.liens.map((l) => (
            <li>
              <a class="bouton" href={l.url} rel="me">
                {l.nom}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="signature-pied">
      <span class="losange" aria-hidden="true"></span>
      {profil.nom} · {annee}
      <span class="losange" aria-hidden="true"></span>
    </p>
  </section>
</Base>

<script>
  // Le repère latéral suit l'écran affiché
  const liens = document.querySelectorAll<HTMLAnchorElement>('.reperes a');
  const observateur = new IntersectionObserver(
    (entrees) => {
      for (const e of entrees) {
        if (!e.isIntersecting) continue;
        liens.forEach((l) => {
          if (l.dataset.ecran === e.target.id) l.setAttribute('aria-current', 'true');
          else l.removeAttribute('aria-current');
        });
      }
    },
    { rootMargin: '-45% 0px -45% 0px' },
  );
  liens.forEach((l) => {
    const cible = document.getElementById(l.dataset.ecran ?? '');
    if (cible) observateur.observe(cible);
  });
</script>

<style>
  /* ——— Repères latéraux ——— */
  .reperes {
    position: fixed;
    right: calc(var(--gouttiere) * 0.5 + 0.9rem);
    top: 50%;
    z-index: 40;
    translate: 0 -50%;
  }

  .reperes ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .reperes a {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
    padding: 0.3rem 0;
    color: var(--gris-or);
    text-decoration: none;
  }

  .repere-nom {
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0;
    translate: 0.5rem 0;
    transition:
      opacity 250ms ease,
      translate 250ms ease;
  }

  .repere-num {
    font-family: var(--f-titre);
    font-size: 0.85rem;
    min-width: 1.6rem;
    text-align: right;
  }

  .repere-trait {
    width: 0.9rem;
    height: 1px;
    background: currentColor;
    transition: width 300ms ease;
  }

  .reperes a:hover .repere-nom,
  .reperes a:focus-visible .repere-nom {
    opacity: 1;
    translate: none;
  }

  .reperes a[aria-current='true'],
  .reperes a:hover {
    color: var(--or-clair);
  }

  .reperes a[aria-current='true'] .repere-trait {
    width: 2rem;
  }

  @media (max-width: 70rem) {
    .reperes {
      display: none;
    }
  }

  /* ——— Introduction ——— */
  .ouverture-grille {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: center;
    gap: 2.5rem clamp(2rem, 6vw, 5rem);
  }

  .script-intro {
    font-family: var(--f-script);
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1;
    color: var(--or);
    margin: 1rem 0 -0.35rem;
  }

  h1 {
    font-size: clamp(3.25rem, 10vw, 8rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.015em;
    color: var(--ivoire);
  }

  .ouverture .filet {
    max-width: 22rem;
    margin: 1.75rem 0 1.5rem;
  }

  .statut {
    font-family: var(--f-titre);
    font-style: italic;
    font-size: clamp(1.25rem, 2.5vw, 1.7rem);
    line-height: 1.3;
    color: var(--or-clair);
  }

  .presentation {
    max-width: var(--mesure);
    margin-top: 0.85rem;
    font-size: 1.15rem;
    color: #ddd3bd;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 2rem;
  }

  .medaillon {
    justify-self: center;
    width: min(100%, 23rem);
  }

  .medaillon-cadre {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 50%;
    padding: 0.6rem;
    border: 1px solid var(--or);
    box-shadow:
      0 0 0 6px var(--carte),
      0 0 0 7px var(--filet),
      0 30px 60px -20px rgba(0, 0, 0, 0.8);
  }

  .medaillon-cadre img,
  .monogramme {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .monogramme {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background:
      radial-gradient(60% 50% at 50% 38%, rgba(236, 217, 168, 0.16), transparent 70%),
      radial-gradient(100% 100% at 50% 100%, #2a1f15, #120e0a);
    border: 1px solid var(--filet);
  }

  .initiales {
    font-family: var(--f-script);
    font-size: clamp(5rem, 14vw, 9rem);
    line-height: 1;
    color: var(--or-clair);
    text-shadow: 0 0 40px rgba(236, 217, 168, 0.25);
    padding-right: 0.15em;
  }

  .devise {
    font-size: 0.6875rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gris-or);
  }

  /* Invitation à défiler */
  /* Sous le médaillon, dans la colonne de droite */
  .defiler {
    position: absolute;
    right: calc(var(--gouttiere) + 5rem + min(100% - 2 * (var(--gouttiere) + 5rem), var(--largeur)) * 0.2);
    bottom: clamp(1.25rem, 3vh, 2.25rem);
    z-index: 1;
    translate: 50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gris-or);
    text-decoration: none;
  }

  .defiler-trait {
    position: relative;
    width: 1px;
    height: 2.75rem;
    overflow: hidden;
    background: rgba(201, 169, 110, 0.2);
  }

  .defiler-trait::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--or-clair);
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .defiler-trait::after {
      animation: descendre 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @keyframes descendre {
      0% {
        transform: translateY(-100%);
      }
      50% {
        transform: translateY(0);
      }
      100% {
        transform: translateY(100%);
      }
    }
  }

  /* ——— Compétences ——— */
  .competences-entete {
    text-align: center;
  }

  .competences-entete .filet {
    max-width: 24rem;
    margin-inline: auto;
  }

  .competences {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .competence {
    flex: 0 1 14.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.4rem 1.1rem 1.4rem;
    border: 1px solid var(--filet-pale);
    background: rgba(13, 11, 8, 0.35);
    transition:
      border-color 350ms ease,
      background-color 350ms ease;
  }

  .competence:hover {
    border-color: rgba(201, 169, 110, 0.5);
    background: rgba(236, 217, 168, 0.05);
  }

  /* Niche en arc, comme une alcôve de bibliothèque */
  .niche {
    position: relative;
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 5.25rem;
    border: 1px solid rgba(201, 169, 110, 0.6);
    border-radius: 999px 999px 3px 3px;
    background: radial-gradient(70% 55% at 50% 45%, rgba(236, 217, 168, 0.14), transparent 75%);
    color: var(--or-clair);
    transition:
      box-shadow 400ms ease,
      border-color 400ms ease;
  }

  .niche::before {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px solid var(--filet-pale);
    border-radius: inherit;
  }

  .niche :global(.icone) {
    width: 2.4rem;
    height: 2.4rem;
  }

  .competence:hover .niche {
    border-color: var(--or-clair);
    box-shadow: 0 0 28px -4px rgba(236, 217, 168, 0.35);
  }

  .competence-nom {
    margin-top: 1rem;
    font-family: var(--f-titre);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--ivoire);
  }

  .competence-detail {
    margin-top: 0.4rem;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--gris-or);
  }

  /* Les pictogrammes se dessinent à l'apparition, puis au survol */
  @media (prefers-reduced-motion: no-preference) {
    .competence :global(.icone path) {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }

    :global(.js) .competence:not(.revele) :global(.icone path) {
      stroke-dashoffset: 1;
    }

    :global(.js) .competence.revele :global(.icone path) {
      animation: dessiner 1400ms cubic-bezier(0.65, 0, 0.35, 1) backwards;
      animation-delay: calc(var(--delai, 0ms) + 300ms + var(--n) * 90ms);
    }

    .competence:hover :global(.icone path) {
      animation: redessiner 1100ms cubic-bezier(0.65, 0, 0.35, 1) backwards !important;
      animation-delay: calc(var(--n) * 70ms) !important;
    }

    @keyframes dessiner {
      from {
        stroke-dashoffset: 1;
      }
    }

    @keyframes redessiner {
      from {
        stroke-dashoffset: 1;
      }
    }
  }

  /* ——— Contact ——— */
  .contact {
    text-align: center;
  }

  .contact .titre-section {
    font-size: clamp(3.5rem, 11vw, 8rem);
  }

  .contact .filet {
    max-width: 24rem;
    margin-inline: auto;
  }

  .courriel {
    font-family: var(--f-titre);
    font-style: italic;
    font-size: clamp(1.5rem, 5vw, 3.25rem);
    overflow-wrap: anywhere;
  }

  .courriel a {
    color: var(--ivoire);
    text-decoration: none;
    background: linear-gradient(var(--or), var(--or)) left bottom / 0 1px no-repeat;
    transition: background-size 400ms ease;
  }

  .courriel a:hover {
    background-size: 100% 1px;
  }

  .liens {
    list-style: none;
    padding: 0;
    margin: 2.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1rem;
  }

  .signature-pied {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(1.5rem, 4vh, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gris-or);
  }

  .losange {
    width: 5px;
    height: 5px;
    background: var(--or);
    transform: rotate(45deg);
  }

  /* ——— Petits écrans ——— */
  @media (max-width: 56rem) {
    .ouverture-grille {
      grid-template-columns: 1fr;
    }

    .medaillon {
      order: -1;
      width: min(60%, 13rem);
    }

    .defiler {
      display: none;
    }

  }

  @media (max-width: 36rem) {
    /* Téléphones : pictogramme à gauche, texte à droite */
    .competence {
      flex-basis: 100%;
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 0 1rem;
      text-align: left;
      padding: 1rem;
    }

    .niche {
      grid-row: span 2;
      width: 3.5rem;
      height: 4.25rem;
    }

    .niche :global(.icone) {
      width: 1.8rem;
      height: 1.8rem;
    }

    .competence-nom {
      margin-top: 0;
      align-self: end;
    }

    .competence-detail {
      align-self: start;
    }
  }
</style>
