---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Frise from '../components/Frise.astro';
import Carrousel from '../components/Carrousel.astro';
import Icone from '../components/Icone.astro';
import Monogramme from '../components/Monogramme.astro';
import { profil, parcours, competences } from '../data/profil';

const travaux = (await getCollection('travaux')).sort(
  (a, b) => b.data.annee - a.data.annee || b.data.debut - a.data.debut,
);

const elementsFrise = travaux.map((t) => ({
  id: t.id,
  titre: t.data.titre,
  nature: t.data.nature,
  debut: t.data.debut,
  fin: t.data.fin,
  enCours: t.data.enCours,
}));

// Initiales pour le médaillon, quand il n'y a pas de portrait
const initiales = profil.nom
  .split(/\s+/)
  .map((m) => m[0])
  .join('');

const enRomain = (n: number) => {
  const table: [number, string][] = [
    [1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'], [100, 'C'], [90, 'XC'],
    [50, 'L'], [40, 'XL'], [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
  ];
  let s = '';
  for (const [v, c] of table) while (n >= v) { s += c; n -= v; }
  return s;
};
const annee = new Date().getFullYear();

// Repères de navigation sur le côté de l'écran
const ecrans = [
  { id: 'accueil', nom: 'Introduction' },
  { id: 'chronologie', nom: 'Chronologie' },
  { id: 'travaux', nom: 'Travaux' },
  { id: 'competences', nom: 'Compétences' },
  { id: 'contact', nom: 'Contact' },
];
---

<Base>
  <nav class="reperes" aria-label="Sections de la page">
    <ol>
      {
        ecrans.map((e, i) => (
          <li>
            <a href={`#${e.id}`} data-ecran={e.id}>
              <span class="repere-nom">{e.nom}</span>
              <span class="repere-num">{enRomain(i + 1)}</span>
              <span class="repere-trait" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <!-- I. Introduction -->
  <section id="accueil" class="ecran ouverture" aria-labelledby="nom">
    <div class="contenu ouverture-grille" data-reveal>
      <!-- Masqué tant que le médaillon n'a pas été ouvert (visible d'emblée sans JavaScript) -->
      <div class="ouverture-texte" id="intro-texte">
        <p class="surtitre" style="--i: 0">Portfolio · Histoire</p>
        <p class="script-intro" aria-hidden="true" style="--i: 1"><span class="ecrit">Introduction</span></p>
        <h1 id="nom" tabindex="-1" style="--i: 2">{profil.nom}</h1>
        <div class="filet" style="--i: 3"></div>
        <p class="statut" style="--i: 4">{profil.statut}</p>
        <p class="presentation" style="--i: 5">{profil.presentation}</p>
        <div class="actions" style="--i: 6">
          <a class="bouton bouton-plein" href="#travaux">Découvrir mes travaux</a>
          <a class="bouton" href={profil.cv} download>Télécharger le CV</a>
        </div>
      </div>

      <div class="medaillon-zone">
        <button
          type="button"
          class="medaillon"
          aria-expanded="false"
          aria-controls="intro-texte"
          aria-label={`Ouvrir le portfolio de ${profil.nom}`}
          data-curseur="Ouvrir"
        >
          <span class="medaillon-onde" aria-hidden="true"></span>
          <span class="medaillon-onde medaillon-onde-2" aria-hidden="true"></span>
          <span class="medaillon-cadre">
            {
              profil.portrait ? (
                <img src={profil.portrait} alt="" />
              ) : (
                <span class="monogramme">
                  <Monogramme
                    initiales={initiales}
                    inscription={`${profil.nom} ✦ ${profil.devise} ✦ ${profil.ville} ✦ `.toUpperCase()}
                    annee={enRomain(annee)}
                  />
                </span>
              )
            }
          </span>
        </button>

        <p class="invitation" aria-hidden="true">
          <span class="invitation-trait"></span>
          <span class="invitation-texte">
            <span class="sur-souris">Cliquez sur le médaillon</span>
            <span class="sur-tactile">Touchez le médaillon</span>
          </span>
          <span class="invitation-trait"></span>
        </p>
      </div>
    </div>

    <a class="defiler" href="#chronologie">
      <span>Défiler</span>
      <span class="defiler-trait" aria-hidden="true"></span>
    </a>
  </section>

  <!-- II. Chronologie -->
  <section id="chronologie" class="ecran" aria-label="Chronologie">
    <div class="contenu">
      <Frise travaux={elementsFrise} parcours={parcours} />
    </div>
  </section>

  <!-- III. Travaux -->
  <Carrousel travaux={travaux} />

  <!-- IV. Compétences -->
  <section id="competences" class="ecran competences-ecran" aria-labelledby="titre-competences">
    <div class="contenu">
      <div class="competences-entete" data-reveal>
        <p class="surtitre">Savoir-faire</p>
        <h2 id="titre-competences" class="titre-section">Compétences</h2>
        <div class="filet filet-centre"></div>
      </div>
      <ul class="competences">
        {
          competences.map((c, i) => (
            <li class="competence" data-reveal style={`--delai: ${(i % 4) * 110}ms`}>
              <span class="niche" aria-hidden="true">
                <Icone nom={c.icone} />
              </span>
              <span class="competence-nom">{c.nom}</span>
              {c.detail && <span class="competence-detail">{c.detail}</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- V. Contact -->
  <section id="contact" class="ecran contact" aria-labelledby="titre-contact">
    <div class="contenu" data-reveal>
      <p class="surtitre">Correspondance</p>
      <h2 id="titre-contact" class="titre-section">Écrivez-moi</h2>
      <div class="filet filet-centre"></div>
      <p class="courriel">
        <a href={`mailto:${profil.email}`}>{profil.email}</a>
      </p>
      <ul class="liens">
        <li><a class="bouton" href={profil.cv} download>CV (PDF)</a></li>
        {
          profil.liens.map((l) => (
            <li>
              <a
                class="bouton"
                href={l.url}
                target={'target' in l ? l.target : undefined}
                rel={'target' in l && l.target === '_blank' ? 'me noopener noreferrer' : 'me'}
              >
                {l.nom}
                {'target' in l && l.target === '_blank' && <span class="visuellement-cache"> (nouvel onglet)</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="signature-pied">
      <span class="losange" aria-hidden="true"></span>
      {profil.nom} · {annee}
      <span class="losange" aria-hidden="true"></span>
    </p>
  </section>
</Base>

<script>
  // ——— Ouverture de l'introduction ———
  // Au départ, seul le médaillon est affiché. Au clic, il glisse à sa place
  // (technique FLIP : on mesure avant / après, puis on anime l'écart) et le texte apparaît.
  const ouverture = document.querySelector<HTMLElement>('.ouverture');
  const medaillon = ouverture?.querySelector<HTMLButtonElement>('.medaillon');
  const titre = ouverture?.querySelector<HTMLElement>('h1');
  const cle = 'intro-ouverte';
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const marquerOuvert = () => {
    if (!ouverture || !medaillon) return;
    ouverture.classList.add('ouverte');
    medaillon.setAttribute('aria-expanded', 'true');
    medaillon.removeAttribute('data-curseur');
    medaillon.tabIndex = -1;
    try {
      sessionStorage.setItem(cle, '1');
    } catch {
      // stockage indisponible (navigation privée) : sans conséquence
    }
  };

  const ouvrir = () => {
    if (!ouverture || !medaillon || ouverture.classList.contains('ouverte')) return;

    if (reduit) {
      marquerOuvert();
      titre?.focus({ preventScroll: true });
      return;
    }

    const avant = medaillon.getBoundingClientRect();
    ouverture.classList.add('eclat');
    marquerOuvert();
    const apres = medaillon.getBoundingClientRect();

    const dx = avant.left + avant.width / 2 - (apres.left + apres.width / 2);
    const dy = avant.top + avant.height / 2 - (apres.top + apres.height / 2);
    const echelle = avant.width / apres.width;
    const depart = `translate(${dx}px, ${dy}px) scale(${echelle})`;
    const appui = `translate(${dx}px, ${dy}px) scale(${echelle * 0.94})`;

    medaillon.animate([{ transform: depart }, { transform: appui, offset: 0.12 }, { transform: 'none' }], {
      duration: 1400,
      easing: 'cubic-bezier(0.65, 0, 0.25, 1)',
    });

    titre?.focus({ preventScroll: true });
  };

  // Déjà ouvert pendant cette visite : on n'impose pas de recliquer en revenant d'une fiche
  // (bouton Retour ou lien interne). Un rechargement de la page (F5, Ctrl+Maj+R) ou une arrivée
  // depuis un autre site remet l'introduction à zéro.
  const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
  const rechargement = navigation?.type === 'reload';
  let depuisLeSite = false;
  try {
    depuisLeSite = !!document.referrer && new URL(document.referrer).origin === location.origin;
  } catch {
    depuisLeSite = false;
  }
  const retour = navigation?.type === 'back_forward' || depuisLeSite;

  let dejaOuvert = false;
  try {
    if (rechargement) sessionStorage.removeItem(cle);
    dejaOuvert = !rechargement && retour && sessionStorage.getItem(cle) === '1';
  } catch {
    dejaOuvert = false;
  }
  if (dejaOuvert && ouverture) {
    ouverture.classList.add('sans-animation');
    marquerOuvert();
  }

  medaillon?.addEventListener('click', ouvrir);
</script>

<script>
  // Le repère latéral suit l'écran affiché
  const liens = document.querySelectorAll<HTMLAnchorElement>('.reperes a');
  const observateur = new IntersectionObserver(
    (entrees) => {
      for (const e of entrees) {
        if (!e.isIntersecting) continue;
        liens.forEach((l) => {
          if (l.dataset.ecran === e.target.id) l.setAttribute('aria-current', 'true');
          else l.removeAttribute('aria-current');
        });
      }
    },
    { rootMargin: '-45% 0px -45% 0px' },
  );
  liens.forEach((l) => {
    const cible = document.getElementById(l.dataset.ecran ?? '');
    if (cible) observateur.observe(cible);
  });
</script>

<style>
  /* ——— Repères latéraux ——— */
  .reperes {
    position: fixed;
    right: calc(var(--gouttiere) * 0.5 + 0.9rem);
    top: 50%;
    z-index: 40;
    translate: 0 -50%;
  }

  .reperes ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .reperes a {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
    padding: 0.3rem 0;
    color: var(--gris-or);
    text-decoration: none;
  }

  .repere-nom {
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0;
    translate: 0.5rem 0;
    transition:
      opacity 250ms ease,
      translate 250ms ease;
  }

  .repere-num {
    font-family: var(--f-titre);
    font-size: 0.85rem;
    min-width: 1.6rem;
    text-align: right;
  }

  .repere-trait {
    width: 0.9rem;
    height: 1px;
    background: currentColor;
    transition: width 300ms ease;
  }

  .reperes a:hover .repere-nom,
  .reperes a:focus-visible .repere-nom {
    opacity: 1;
    translate: none;
  }

  .reperes a[aria-current='true'],
  .reperes a:hover {
    color: var(--or-clair);
  }

  .reperes a[aria-current='true'] .repere-trait {
    width: 2rem;
  }

  @media (max-width: 70rem) {
    .reperes {
      display: none;
    }
  }

  /* ——— Introduction ——— */
  .ouverture-grille {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: center;
    gap: 2.5rem clamp(2rem, 6vw, 5rem);
  }

  .script-intro {
    font-family: var(--f-script);
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1;
    color: var(--or);
    margin: 1rem 0 -0.35rem;
  }

  h1 {
    font-family: var(--f-affiche);
    font-size: clamp(3rem, 9vw, 7.25rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.015em;
    color: var(--ivoire);
  }

  /* Le titre reçoit le focus à l'ouverture (pour les lecteurs d'écran) : pas de cadre visible */
  #nom:focus {
    outline: none;
  }

  .ouverture .filet {
    max-width: 22rem;
    margin: 1.75rem 0 1.5rem;
  }

  .statut {
    font-family: var(--f-titre);
    font-style: italic;
    font-size: clamp(1.25rem, 2.5vw, 1.7rem);
    line-height: 1.3;
    color: var(--or-clair);
  }

  .presentation {
    max-width: var(--mesure);
    margin-top: 0.85rem;
    font-size: 1.15rem;
    color: #ddd3bd;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 2rem;
  }

  /* Médaillon : un bouton tant que l'introduction est fermée */
  .medaillon-zone {
    position: relative;
    justify-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100%, 23rem);
  }

  .medaillon {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    border-radius: 50%;
    transform-origin: center;
  }

  .ouverte .medaillon {
    cursor: default;
  }

  .medaillon:focus-visible {
    outline: none;
  }

  .medaillon:focus-visible .medaillon-cadre {
    box-shadow:
      0 0 0 6px var(--carte),
      0 0 0 8px var(--or-clair),
      0 30px 60px -20px rgba(0, 0, 0, 0.8);
  }

  .medaillon-cadre {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: 50%;
    padding: 0.6rem;
    border: 1px solid var(--or);
    box-shadow:
      0 0 0 6px var(--carte),
      0 0 0 7px var(--filet),
      0 30px 60px -20px rgba(0, 0, 0, 0.8);
    transition: box-shadow 500ms ease;
  }

  .medaillon-cadre img,
  .monogramme {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .monogramme {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background:
      radial-gradient(60% 50% at 50% 38%, rgba(236, 217, 168, 0.16), transparent 70%),
      radial-gradient(100% 100% at 50% 100%, #2a1f15, #120e0a);
    border: 1px solid var(--filet);
  }

  .initiales {
    font-family: var(--f-script);
    font-size: clamp(5rem, 14vw, 9rem);
    line-height: 1;
    color: var(--or-clair);
    text-shadow: 0 0 40px rgba(236, 217, 168, 0.25);
    padding-right: 0.15em;
    transition: text-shadow 500ms ease;
  }

  /* Ondes dorées qui invitent au clic */
  .medaillon-onde {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--or-clair);
    opacity: 0;
    pointer-events: none;
  }

  /* Invitation sous le médaillon */
  .invitation {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: clamp(1.75rem, 5vh, 2.75rem);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--or-clair);
    white-space: nowrap;
  }

  .invitation-trait {
    width: 2.5rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--or));
  }

  .invitation-trait:last-child {
    background: linear-gradient(90deg, var(--or), transparent);
  }

  .sur-tactile {
    display: none;
  }

  @media (hover: none) {
    .sur-souris {
      display: none;
    }

    .sur-tactile {
      display: inline;
    }
  }

  /* ——— État fermé (avec JavaScript seulement) : les initiales seules, au centre ——— */
  :global(.js) .ouverture:not(.ouverte) .ouverture-grille {
    grid-template-columns: 1fr;
    justify-items: center;
  }

  :global(.js) .ouverture:not(.ouverte) .ouverture-texte {
    display: none;
  }

  :global(.js) .ouverture:not(.ouverte) .medaillon-zone {
    width: min(78vw, 25rem, 39vh);
  }

  :global(.js) .ouverture:not(.ouverte) .medaillon:hover .medaillon-cadre {
    box-shadow:
      0 0 0 6px var(--carte),
      0 0 0 7px var(--or),
      0 0 60px -6px rgba(236, 217, 168, 0.35),
      0 30px 60px -20px rgba(0, 0, 0, 0.8);
  }

  :global(.js) .ouverture:not(.ouverte) .medaillon:hover .monogramme {
    filter: brightness(1.15) drop-shadow(0 0 18px rgba(236, 217, 168, 0.25));
  }

  .monogramme {
    transition: filter 500ms ease;
  }

  :global(html:not(.js)) .invitation,
  .ouverte .invitation {
    display: none;
  }

  :global(.js) .ouverture:not(.ouverte) .defiler {
    opacity: 0;
    pointer-events: none;
  }

  .defiler {
    transition: opacity 800ms ease 1.6s;
  }

  .sans-animation .defiler {
    transition: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Respiration lente du médaillon et ondes qui s'en échappent */
    :global(.js) .ouverture:not(.ouverte) .medaillon {
      animation: respirer 3.2s ease-in-out infinite;
    }

    :global(.js) .ouverture:not(.ouverte) .medaillon-onde {
      animation: onde 3.2s cubic-bezier(0.2, 0.7, 0.2, 1) infinite;
    }

    :global(.js) .ouverture:not(.ouverte) .medaillon-onde-2 {
      animation-delay: 1.6s;
    }

    :global(.js) .ouverture:not(.ouverte) .invitation {
      animation: inviter 3.2s ease-in-out infinite;
    }

    @keyframes respirer {
      50% {
        transform: scale(1.025);
      }
    }

    @keyframes onde {
      0% {
        opacity: 0.6;
        transform: scale(1);
      }
      100% {
        opacity: 0;
        transform: scale(1.22);
      }
    }

    @keyframes inviter {
      0%,
      100% {
        opacity: 0.55;
      }
      50% {
        opacity: 1;
      }
    }

    /* Au clic : un éclat d'or part du médaillon */
    .eclat .medaillon-onde {
      animation: eclat 1100ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .eclat .medaillon-onde-2 {
      animation-delay: 140ms;
    }

    @keyframes eclat {
      0% {
        opacity: 0.9;
        transform: scale(1);
        border-width: 2px;
      }
      100% {
        opacity: 0;
        transform: scale(1.6);
        border-width: 1px;
      }
    }

    /* Le texte de l'introduction surgit ligne à ligne */
    .ouverte:not(.sans-animation) .ouverture-texte > * {
      animation: surgir 1100ms cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
      animation-delay: calc(550ms + var(--i) * 140ms);
    }

    .ouverte:not(.sans-animation) .ouverture-texte > .filet {
      animation-name: deplier;
      transform-origin: left center;
    }

    @keyframes surgir {
      from {
        opacity: 0;
        transform: translateY(1.75rem);
        filter: blur(6px);
      }
    }

    @keyframes deplier {
      from {
        opacity: 0;
        transform: scaleX(0);
      }
    }
  }

  .devise {
    font-size: 0.6875rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gris-or);
  }

  /* Invitation à défiler */
  /* Sous le médaillon, dans la colonne de droite */
  .defiler {
    position: absolute;
    right: calc(var(--gouttiere) + 5rem + min(100% - 2 * (var(--gouttiere) + 5rem), var(--largeur)) * 0.2);
    bottom: clamp(1.25rem, 3vh, 2.25rem);
    z-index: 1;
    translate: 50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gris-or);
    text-decoration: none;
  }

  .defiler-trait {
    position: relative;
    width: 1px;
    height: 2.75rem;
    overflow: hidden;
    background: rgba(201, 169, 110, 0.2);
  }

  .defiler-trait::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--or-clair);
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .defiler-trait::after {
      animation: descendre 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @keyframes descendre {
      0% {
        transform: translateY(-100%);
      }
      50% {
        transform: translateY(0);
      }
      100% {
        transform: translateY(100%);
      }
    }
  }

  /* ——— Compétences ——— */
  .competences-entete {
    text-align: center;
  }

  .competences-entete .titre-section,
  .contact .titre-section {
    margin-inline: auto;
  }

  .competences-entete .filet {
    max-width: 24rem;
    margin-inline: auto;
  }

  .competences {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .competence {
    flex: 0 1 14.25rem;
    display: flex;
