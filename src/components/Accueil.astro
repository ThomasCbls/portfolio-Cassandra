    gap: 0.75rem;
    background:
      radial-gradient(60% 50% at 50% 38%, rgba(236, 217, 168, 0.16), transparent 70%),
      radial-gradient(100% 100% at 50% 100%, #2a1f15, #120e0a);
    border: 1px solid var(--filet);
