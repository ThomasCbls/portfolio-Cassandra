---
// Page d'accueil, commune aux deux langues (src/pages/index.astro et src/pages/en/index.astro).
import Base from '../layouts/Base.astro';
import Frise from './Frise.astro';
import Parcours from './Parcours.astro';
import Carrousel from './Carrousel.astro';
import Icone from './Icone.astro';
import Monogramme from './Monogramme.astro';
import { profil as profilFr, parcours as parcoursFr, competences as competencesFr, outils as outilsFr } from '../data/profil';
import { chargerTravaux } from '../data/travaux';
import { lien, localiser, t, type Langue } from '../i18n';
import { dateRepublicaine, romain } from '../data/republicain';

interface Props {
  lang: Langue;
}

const { lang } = Astro.props;
const tx = t(lang);
const profil = localiser(profilFr, lang);
// Les dates françaises restent la référence de calcul de la frise (datesSource)
const parcours = parcoursFr.map((p) => ({ ...localiser(p, lang), datesSource: p.dates }));
const competences = competencesFr.map((c) => localiser(c, lang));
const outils = outilsFr.map((o) => localiser(o, lang));
const travaux = await chargerTravaux(lang);

// Frise « Siècles étudiés » : seulement les travaux dont la période est renseignée
const elementsFrise = travaux
  .filter((t) => t.data.debut !== undefined && t.data.fin !== undefined)
  .map((t) => ({
    id: t.id,
    titre: t.data.titre,
    nature: t.data.nature,
    debut: t.data.debut as number,
    fin: t.data.fin as number,
    enCours: t.data.enCours,
  }));

// Initiales pour le médaillon, quand il n'y a pas de portrait
const initiales = profil.nom
  .split(/\s+/)
  .map((m) => m[0])
  .join('');

const annee = new Date().getFullYear();

// Bibliothèque : dimensions des livres, variées pour un rayonnage naturel
const hauteurs = [14, 12.4, 15.2, 13, 14.6, 12, 15.6, 13.4, 14.2, 12.8];
const largeurs = [3.3, 2.8, 3.7, 3, 3.4, 2.9, 3.6, 3.1, 3.3, 2.9];

// Date de la lettre (mise à jour dans le navigateur au jour de la visite)
const dateLettre = new Date().toLocaleDateString(tx.locale, { day: 'numeric', month: 'long', year: 'numeric' });

// Sceau de cire : contour irrégulier calculé une fois pour toutes
const contourSceau = (() => {
  const variations = [0, 3, -2, 4, 1, -3, 2, 5, -1, 3, -2, 2, 4, -3, 1, 3, -1, 2];
  const pts = variations.map((v, i) => {
    const a = (i / variations.length) * Math.PI * 2;
    const r = 52 + v;
    return [60 + r * Math.cos(a), 60 + r * Math.sin(a)];
  });
  const milieu = (p: number[], q: number[]) => [(p[0] + q[0]) / 2, (p[1] + q[1]) / 2];
  let d = '';
  pts.forEach((p, i) => {
    const q = pts[(i + 1) % pts.length];
    const m = milieu(p, q);
    if (i === 0) d += `M${milieu(pts[pts.length - 1], p).map((n) => n.toFixed(1)).join(' ')}`;
    d += `Q${p[0].toFixed(1)} ${p[1].toFixed(1)} ${m[0].toFixed(1)} ${m[1].toFixed(1)}`;
  });
  return d + 'Z';
})();

// Fêlure du sceau quand on le brise : ligne brisée de haut en bas, et les deux moitiés qu'elle découpe
const fentePoints = [[57, 0], [62, 18], [55, 34], [64, 50], [56, 64], [63, 80], [55, 96], [61, 120]]
  .map((p) => p.join(' '))
  .join('L');
const fente = `M${fentePoints}`;
const clipGauche = `M-10 -10L57 -10L${fentePoints}L61 130L-10 130Z`;
const clipDroite = `M130 -10L57 -10L${fentePoints}L61 130L130 130Z`;

// Chapitres de la page, dans l'ordre. « Siècles étudiés » n'apparaît que si au moins un travail
// a une période renseignée (champs `debut` et `fin`) ; les numéros des chapitres suivent.
type Ecran = keyof typeof tx.ecrans;
const ordre: Ecran[] = [
  'accueil',
  'parcours',
  ...(elementsFrise.length > 0 ? (['siecles'] as const) : []),
  'travaux',
  'competences',
  'bibliotheque',
  'contact',
];
const numero = (id: Ecran) => romain(ordre.indexOf(id) + 1);

// Repères de navigation sur le côté de l'écran
const ecrans = ordre.map((id) => ({ id, nom: tx.ecrans[id] }));

// Livres de la bibliothèque : le travail lié (s'il existe) pour le lien « Voir le projet »
const travailDe = (id?: string) => (id ? travaux.find((tr) => tr.id === id) : undefined);
---

<Base>
  <nav class="reperes" aria-label={tx.sections}>
    <ol>
      {
        ecrans.map((e, i) => (
          <li>
            <a href={`#${e.id}`} data-ecran={e.id}>
              <span class="repere-nom">{e.nom}</span>
              <span class="repere-num">{romain(i + 1)}</span>
              <span class="repere-trait" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <!-- I. Introduction -->
  <section id="accueil" class="ecran ouverture" aria-labelledby="nom">
    <div class="contenu ouverture-grille" data-reveal>
      <!-- Masqué tant que le médaillon n'a pas été ouvert (visible d'emblée sans JavaScript) -->
      <div class="ouverture-texte" id="intro-texte">
        <p class="surtitre" style="--i: 0"><span class="chapitre">{tx.chapitre} {numero('accueil')}</span> {tx.portfolio}</p>
        <p class="script-intro" aria-hidden="true" style="--i: 1"><span class="ecrit">{tx.introduction}</span></p>
        <h1 id="nom" tabindex="-1" style="--i: 2">{profil.nom}</h1>
        <div class="filet" style="--i: 3"></div>
        <p class="statut" style="--i: 4">{profil.statut}</p>
        <p class="presentation" style="--i: 5">{profil.presentation}</p>
        <div class="actions" style="--i: 6">
          <a class="bouton bouton-plein" href="#travaux">{tx.decouvrir}</a>
          <a class="bouton" href={profil.cv} download>{tx.telechargerCv}</a>
        </div>
      </div>

      <div class="medaillon-zone">
        <button
          type="button"
          class="medaillon"
          aria-expanded="false"
          aria-controls="intro-texte"
          aria-label={tx.ouvrirPortfolio(profil.nom)}
          data-curseur={tx.curseurOuvrir}
        >
          <span class="medaillon-onde" aria-hidden="true"></span>
          <span class="medaillon-onde medaillon-onde-2" aria-hidden="true"></span>
          <span class="medaillon-cadre objet-sombre">
            {
              profil.portrait ? (
                <img src={profil.portrait} alt="" />
              ) : (
                <span class="monogramme">
                  <Monogramme
                    initiales={initiales}
                    inscription={`${profil.nom} ✦ ${profil.devise} ✦ ${profil.ville} ✦ `.toUpperCase()}
                    annee={romain(annee)}
                  />
                </span>
              )
            }
          </span>
        </button>

        <p class="invitation" aria-hidden="true">
          <span class="invitation-trait"></span>
          <span class="invitation-texte">
            <span class="sur-souris">{tx.cliquezMedaillon}</span>
            <span class="sur-tactile">{tx.touchezMedaillon}</span>
          </span>
          <span class="invitation-trait"></span>
        </p>
      </div>
    </div>

    <a class="defiler" href="#parcours">
      <span>{tx.defiler}</span>
      <span class="defiler-trait" aria-hidden="true"></span>
    </a>
  </section>

  <!-- II. Parcours : chronologie et cartographie -->
  <Parcours lang={lang} parcours={parcours} travaux={travaux} numero={numero('parcours')} />

  <!-- III. Siècles étudiés (si au moins un travail a une période) -->
  {
    elementsFrise.length > 0 && (
      <section id="siecles" class="ecran">
        <div class="contenu">
          <Frise vue="siecles" travaux={elementsFrise} lang={lang} numero={numero('siecles')} />
        </div>
      </section>
    )
  }

  <!-- IV. Travaux -->
  <Carrousel travaux={travaux} lang={lang} numero={numero('travaux')} />

  <!-- V. Compétences -->
  <section id="competences" class="ecran competences-ecran" aria-labelledby="titre-competences">
    <div class="contenu">
      <div class="competences-entete" data-reveal>
        <p class="surtitre"><span class="chapitre">{tx.chapitre} {numero('competences')}</span> {tx.competences.surtitre}</p>
        <h2 id="titre-competences" class="titre-section">{tx.competences.titre}</h2>
        <div class="filet filet-centre"></div>
      </div>
      <ul class="competences">
        {
          competences.map((c, i) => (
            <li class="competence" data-reveal style={`--delai: ${(i % 4) * 110}ms`}>
              <span class="niche" aria-hidden="true">
                <Icone nom={c.icone} />
              </span>
              <span class="competence-nom">{c.nom}</span>
              {c.detail && <span class="competence-detail">{c.detail}</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- VI. Bibliothèque -->
  <section id="bibliotheque" class="ecran bibliotheque-ecran" aria-labelledby="titre-bibliotheque">
    <div class="contenu">
      <div class="bibliotheque-entete" data-reveal>
        <p class="surtitre"><span class="chapitre">{tx.chapitre} {numero('bibliotheque')}</span> {tx.bibliotheque.surtitre}</p>
        <h2 id="titre-bibliotheque" class="titre-section">{tx.bibliotheque.titre}</h2>
        <div class="filet filet-centre"></div>
      </div>
      <div class="etagere" data-reveal>
        <ul class="livres">
          {
            outils.map((o, i) => (
              <li
                class="livre"
                data-teinte={o.teinte}
                style={`--h: ${hauteurs[i % hauteurs.length]}rem; --l: ${largeurs[i % largeurs.length]}rem; --i: ${i}`}
              >
                <button
                  type="button"
                  class="livre-bouton"
                  aria-haspopup="dialog"
                  aria-controls={`livre-${i}`}
                  aria-label={tx.bibliotheque.ouvrir(o.nom)}
                  data-curseur={tx.bibliotheque.curseur}
                >
                  <span class="livre-dos objet-sombre">
                    <span class="livre-titre">{o.nom}</span>
                  </span>
                  <span class="livre-etiquette" aria-hidden="true">{o.rayon}</span>
                </button>
              </li>
            ))
          }
        </ul>
        <div class="planche" aria-hidden="true"></div>
      </div>
    </div>

    <!-- Livres ouverts : une double page par outil -->
    {
      outils.map((o, i) => {
        const travail = travailDe(o.travail);
        const niveau = Math.min(3, Math.max(1, o.niveau ?? 1));
        return (
          <dialog class="livre-ouvert" id={`livre-${i}`} data-teinte={o.teinte} aria-labelledby={`livre-titre-${i}`}>
            <div class="livre-couverture">
              <div class="livre-page page-gauche">
                <p class="page-rayon">
                  {tx.bibliotheque.rayon} · {o.rayon}
                </p>
                <h3 id={`livre-titre-${i}`} class="page-titre">
                  {o.nom}
                </h3>
                <div class="page-fleuron" aria-hidden="true">
                  <span />
                </div>
                <p class="page-rubrique">{tx.bibliotheque.niveau}</p>
                <p class="plumes" role="img" aria-label={`${niveau} / 3 : ${tx.bibliotheque.niveaux[niveau - 1]}`}>
                  {[1, 2, 3].map((n) => (
                    <svg viewBox="0 0 24 24" class:list={['plume', { pleine: n <= niveau }]} aria-hidden="true">
                      <path d="M20 3c-6 0-11.5 4.5-12.5 11.5C14.5 13.5 19 9 20 3z" />
                      <path d="M16 7 4.5 19.5" />
                    </svg>
                  ))}
                </p>
                <p class="page-niveau">{tx.bibliotheque.niveaux[niveau - 1]}</p>
                <p class="page-folio" aria-hidden="true">
                  {romain(2 * i + 1)}
                </p>
              </div>
              <div class="livre-page page-droite">
                <p class="page-rubrique">{tx.bibliotheque.usage}</p>
                <p class="page-usage lettrine">{o.usage}</p>
                {travail && (
                  <p class="page-lien">
                    <a href={lien(lang, `/travaux/${travail.id}/`)}>
                      <span class="page-lien-libelle">{tx.bibliotheque.exemple}</span>
                      <span class="page-lien-titre">{travail.data.titre} →</span>
                    </a>
                  </p>
                )}
                <p class="page-folio" aria-hidden="true">
                  {romain(2 * i + 2)}
                </p>
              </div>
            </div>
            <button type="button" class="livre-fermer" aria-label={tx.bibliotheque.fermer}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 6l12 12M18 6 6 18" />
              </svg>
            </button>
          </dialog>
        );
      })
    }
  </section>

  <!-- VII. Contact : une lettre scellée -->
  <section id="contact" class="ecran contact" aria-labelledby="titre-contact">
    <div class="contenu" data-reveal>
      <p class="surtitre"><span class="chapitre">{tx.chapitre} {numero('contact')}</span> {tx.contact.surtitre}</p>
      <h2 id="titre-contact" class="titre-section">{tx.contact.titre}</h2>

      <div class="lettre">
        <p class="lettre-date">
          {tx.contact.date(profil.ville)}<time
            class="date-du-jour"
            tabindex="0"
            data-locale={tx.locale}
            data-lang={lang}
            aria-describedby="date-republicaine">{dateLettre}</time
          ><span class="date-republicaine" id="date-republicaine" role="tooltip">
            <span class="date-republicaine-libelle">{tx.contact.republicain}</span>
            <span class="date-republicaine-texte">{dateRepublicaine(new Date(), lang)}</span>
          </span>
        </p>
        <p class="lettre-salutation">{tx.contact.salutation}</p>
        <p class="lettre-corps">{tx.contact.corps}</p>
        <p class="lettre-courriel">
          <a href={`mailto:${profil.email}`}>{profil.email}</a>
        </p>
        <p class="lettre-signature">{profil.nom}</p>

        <!-- Sceau de cire : un clic le brise et copie l'adresse -->
        <button
          type="button"
          class="sceau"
          aria-label={tx.contact.sceau}
          data-curseur={tx.contact.curseurSceau}
          data-email={profil.email}
          data-copiee={tx.contact.copiee}
          data-impossible={tx.contact.copieImpossible}
        >
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <defs>
              <radialGradient id="cire" cx="0.42" cy="0.38" r="0.7">
                <stop offset="0" stop-color="#c2412f"></stop>
                <stop offset="0.55" stop-color="#8f2219"></stop>
                <stop offset="1" stop-color="#5a110c"></stop>
              </radialGradient>
              <clipPath id="sceau-gauche"><path d={clipGauche}></path></clipPath>
              <clipPath id="sceau-droite"><path d={clipDroite}></path></clipPath>
            </defs>
            {
              ['gauche', 'droite'].map((cote) => (
                <g class={`moitie moitie-${cote}`} clip-path={`url(#sceau-${cote})`}>
                  <path d={contourSceau} fill="url(#cire)" />
                  <circle cx="60" cy="60" r="37" fill="none" stroke="#5a110c" stroke-width="2.5" opacity="0.7" />
                  <circle cx="60" cy="60" r="35" fill="none" stroke="#d9654f" stroke-width="0.8" opacity="0.45" />
                  <text x="61" y="76" class="sceau-lettres sceau-ombre">
                    {initiales}
                  </text>
                  <text x="59.5" y="74.5" class="sceau-lettres">
                    {initiales}
                  </text>
                </g>
              ))
            }
            <path d={fente} class="fente" pathLength="1"></path>
          </svg>
        </button>
        <p class="sceau-message" role="status"></p>
      </div>

      <ul class="liens">
        <li><a class="bouton" href={profil.cv} download>{tx.contact.cv}</a></li>
        {
          profil.liens.map((l) => (
            <li>
              <a
                class="bouton"
                href={l.url}
                target={'target' in l ? l.target : undefined}
                rel={'target' in l && l.target === '_blank' ? 'me noopener noreferrer' : 'me'}
              >
                {l.nom}
                {'target' in l && l.target === '_blank' && <span class="visuellement-cache">{tx.contact.nouvelOnglet}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="signature-pied">
      <span class="losange" aria-hidden="true"></span>
      {profil.nom} · {annee}
      <span class="losange" aria-hidden="true"></span>
    </p>
  </section>

</Base>

<script>
  import { dateRepublicaine } from '../data/republicain';

  // ——— La lettre est datée du jour de la visite (et du calendrier républicain au survol) ———
  const date = document.querySelector<HTMLElement>('.date-du-jour');
  if (date) {
    const aujourdhui = new Date();
    date.textContent = aujourdhui.toLocaleDateString(date.dataset.locale || 'fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
    const republicaine = document.querySelector('.date-republicaine-texte');
    if (republicaine) republicaine.textContent = dateRepublicaine(aujourdhui, date.dataset.lang === 'en' ? 'en' : 'fr');
  }

  // ——— Sceau de cire : il se brise, l'adresse est copiée ———
  const sceau = document.querySelector<HTMLButtonElement>('.sceau');
  const message = document.querySelector<HTMLElement>('.sceau-message');
  let reformer = 0;

  const annoncer = (texte: string) => {
    if (!message) return;
    message.textContent = texte;
    message.classList.remove('visible');
    void message.offsetWidth; // relance l'animation
    message.classList.add('visible');
  };

  sceau?.addEventListener('click', async () => {
    if (sceau.classList.contains('brise')) return;
    const email = sceau.dataset.email ?? '';
    sceau.classList.remove('reappose');
    sceau.classList.add('brise');

    try {
      await navigator.clipboard.writeText(email);
      annoncer(sceau.dataset.copiee ?? '');
    } catch {
      // Presse-papiers refusé : on sélectionne l'adresse pour une copie à la main
      const lienCourriel = document.querySelector('.lettre-courriel a');
      if (lienCourriel) {
        const plage = document.createRange();
        plage.selectNodeContents(lienCourriel);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(plage);
      }
      annoncer(sceau.dataset.impossible ?? '');
    }

    // Un nouveau sceau est apposé quelques secondes plus tard
    window.clearTimeout(reformer);
    reformer = window.setTimeout(() => {
      sceau.classList.remove('brise');
      sceau.classList.add('reappose');
    }, 3200);
  });

  // ——— Livres de la bibliothèque : une double page s'ouvre ———
  const reduitLivres = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLButtonElement>('.livre-bouton').forEach((bouton) => {
    const livre = document.getElementById(bouton.getAttribute('aria-controls') ?? '') as HTMLDialogElement | null;
    if (!livre) return;

    bouton.addEventListener('click', () => {
      livre.classList.remove('fermeture');
      livre.showModal();
    });

    // Fermeture : le livre se referme avant de disparaître
    const fermer = () => {
      if (!livre.open || livre.classList.contains('fermeture')) return;
      if (reduitLivres) return livre.close();
      livre.classList.add('fermeture');
      window.setTimeout(() => {
        livre.close();
        livre.classList.remove('fermeture');
      }, 380);
    };

    livre.querySelector('.livre-fermer')?.addEventListener('click', fermer);
    livre.addEventListener('cancel', (e) => {
      e.preventDefault();
      fermer();
    });
    // Clic en dehors du livre (sur le fond assombri)
    livre.addEventListener('click', (e) => {
      if (e.target === livre) fermer();
    });
  });
</script>

<script>
  // ——— Ouverture de l'introduction ———
  // Au départ, seul le médaillon est affiché. Au clic, il glisse à sa place
  // (technique FLIP : on mesure avant / après, puis on anime l'écart) et le texte apparaît.
  const ouverture = document.querySelector<HTMLElement>('.ouverture');
  const medaillon = ouverture?.querySelector<HTMLButtonElement>('.medaillon');
  const titre = ouverture?.querySelector<HTMLElement>('h1');
  const cle = 'intro-ouverte';
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const marquerOuvert = () => {
    if (!ouverture || !medaillon) return;
    ouverture.classList.add('ouverte');
    medaillon.setAttribute('aria-expanded', 'true');
    medaillon.removeAttribute('data-curseur');
    medaillon.tabIndex = -1;
    try {
      sessionStorage.setItem(cle, '1');
    } catch {
      // stockage indisponible (navigation privée) : sans conséquence
    }
  };

  const ouvrir = () => {
    if (!ouverture || !medaillon || ouverture.classList.contains('ouverte')) return;

    if (reduit) {
      marquerOuvert();
      titre?.focus({ preventScroll: true });
      return;
    }

    const avant = medaillon.getBoundingClientRect();
    ouverture.classList.add('eclat');
    marquerOuvert();
    const apres = medaillon.getBoundingClientRect();

    const dx = avant.left + avant.width / 2 - (apres.left + apres.width / 2);
    const dy = avant.top + avant.height / 2 - (apres.top + apres.height / 2);
    const echelle = avant.width / apres.width;
    const depart = `translate(${dx}px, ${dy}px) scale(${echelle})`;
    const appui = `translate(${dx}px, ${dy}px) scale(${echelle * 0.94})`;

    medaillon.animate([{ transform: depart }, { transform: appui, offset: 0.12 }, { transform: 'none' }], {
      duration: 1400,
      easing: 'cubic-bezier(0.65, 0, 0.25, 1)',
    });

    titre?.focus({ preventScroll: true });
  };

  // Déjà ouvert pendant cette visite : on n'impose pas de recliquer en revenant d'une fiche
  // (bouton Retour ou lien interne). Un rechargement de la page (F5, Ctrl+Maj+R) ou une arrivée
  // depuis un autre site remet l'introduction à zéro.
  const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
  const rechargement = navigation?.type === 'reload';
  let depuisLeSite = false;
  try {
    depuisLeSite = !!document.referrer && new URL(document.referrer).origin === location.origin;
  } catch {
    depuisLeSite = false;
  }
  const retour = navigation?.type === 'back_forward' || depuisLeSite;

  let dejaOuvert = false;
  try {
    if (rechargement) sessionStorage.removeItem(cle);
    dejaOuvert = !rechargement && retour && sessionStorage.getItem(cle) === '1';
  } catch {
    dejaOuvert = false;
  }
  if (dejaOuvert && ouverture) {
    ouverture.classList.add('sans-animation');
    marquerOuvert();
  }

  medaillon?.addEventListener('click', ouvrir);
</script>

<script>
  import { romain } from '../data/republicain';

  // ——— Pages empilées et repère latéral ———
  // Les positions « au repos » des écrans sont mesurées une fois (puis à chaque changement de taille) :
  // au défilement, tout se calcule à partir de window.scrollY, sans relire la mise en page,
  // et on n'écrit dans le DOM que ce qui a changé.
  const ecrans = [...document.querySelectorAll<HTMLElement>('main > .ecran')];
  const liensReperes = [...document.querySelectorAll<HTMLAnchorElement>('.reperes a')];
  const racine = document.documentElement;
  const moinsDeMouvement = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const empile = !moinsDeMouvement && ecrans.length > 1;

  if (empile) racine.classList.add('empilement');

  // Voile qui assombrit l'écran recouvert (une opacité s'anime sans redessiner la page)
  const voiles = ecrans.map((ecran) => {
    if (!empile) return null;
    const voile = document.createElement('span');
    voile.className = 'voile';
    voile.setAttribute('aria-hidden', 'true');
    ecran.append(voile);
    return voile;
  });

  // Grand numéro du chapitre en filigrane : il glisse plus vite que la page (effet de profondeur)
  const numeros = ecrans.map((ecran, i) => {
    if (!empile || i === 0) return null;
    const numero = document.createElement('span');
    numero.className = 'numero-filigrane';
    numero.setAttribute('aria-hidden', 'true');
    numero.textContent = romain(i + 1);
    ecran.append(numero);
    return numero;
  });

  let hFenetre = window.innerHeight;
  let plages: { debut: number; fin: number }[] = [];

  // Mesure (lectures groupées), puis collage (écritures groupées) :
  // un écran plus haut que la fenêtre se colle par le bas, tout son contenu reste lisible.
  const mesurer = () => {
    hFenetre = window.innerHeight;
    const hauteurs = ecrans.map((e) => e.offsetHeight);
    const main = ecrans[0]?.parentElement;
    let y = main ? main.getBoundingClientRect().top + window.scrollY : 0;
    plages = hauteurs.map((h) => {
      const debut = y;
      y += h;
      return { debut, fin: debut + Math.max(0, h - hFenetre) };
    });
    if (!empile) return;
    ecrans.forEach((e, i) => {
      const top = `${Math.min(0, hFenetre - hauteurs[i])}px`;
      if (e.style.top !== top) e.style.top = top;
    });
  };

  // Dernier état appliqué à chaque écran : on n'écrit dans le DOM que ce qui change
  const etats = ecrans.map(() => ({ entree: -1, part: -1 }));
  const recouverts = ecrans.map(() => false);
  let courantId = '';
  let enAttente = false;

  const mettreAJour = () => {
    enAttente = false;
    const y = window.scrollY;
    let courant = 0;

    // Part de chaque écran recouverte par le suivant (0 → 1)
    const parts = ecrans.map((_, i) => {
      if (plages[i].debut - y <= hFenetre * 0.5) courant = i;
      const suivant = plages[i + 1];
      return suivant ? Math.round(Math.min(1, Math.max(0, 1 - (suivant.debut - y) / hFenetre)) * 1000) / 1000 : 0;
    });

    ecrans.forEach((ecran, i) => {
      const part = parts[i];
      // Arrivée de l'écran : 0 quand il pointe en bas de la fenêtre, 1 quand il la couvre
      const entree = i === 0 ? 1 : parts[i - 1];
      const etat = etats[i];

      if (empile && (part !== etat.part || entree !== etat.entree)) {
        etat.part = part;
        etat.entree = entree;
        const reste = 1 - entree;
        // Rideau : la page arrive comme une carte aux coins arrondis, qui s'aplatissent en fin de course ;
        // la page quittée recule, remonte légèrement et se floute dans la profondeur
        const echelle = (1 - reste * 0.04) * (1 - part * 0.06);
        ecran.style.transform =
          reste > 0 || part > 0 ? `translate3d(0, ${(-part * 4).toFixed(2)}vh, 0) scale(${echelle.toFixed(4)})` : '';
        const rayon = reste > 0 ? `${(reste * 2.75).toFixed(3)}rem` : '';
        ecran.style.borderTopLeftRadius = rayon;
        ecran.style.borderTopRightRadius = rayon;
        ecran.style.filter = part > 0.01 ? `blur(${(part * 3).toFixed(2)}px)` : '';
        const voile = voiles[i];
        if (voile) voile.style.opacity = part > 0 ? String(part * 0.55) : '';
        const numero = numeros[i];
        if (numero) numero.style.transform = reste > 0 || part > 0 ? `translate3d(0, ${(reste * 45 - part * 25).toFixed(2)}vh, 0)` : '';
      }

      // Entièrement recouvert : ses animations se réinitialisent (elles se rejoueront au retour)
      const recouvert = part >= 0.999;
      if (recouvert !== recouverts[i]) {
        recouverts[i] = recouvert;
        ecran.classList.toggle('recouverte', recouvert);
        ecran.querySelectorAll('[data-reveal]').forEach((el) => el.classList.toggle('revele', !recouvert));
      }
    });

    const id = ecrans[courant]?.id ?? '';
    if (id !== courantId) {
      courantId = id;
      liensReperes.forEach((l) => {
        if (l.dataset.ecran === id) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      });
    }
  };

  const demander = () => {
    if (enAttente) return;
    enAttente = true;
    requestAnimationFrame(mettreAJour);
  };

  const remesurer = () => {
    mesurer();
    demander();
  };

  mesurer();
  mettreAJour();
  window.addEventListener('scroll', demander, { passive: true });
  window.addEventListener('resize', remesurer);
  window.addEventListener('load', remesurer);
  document.fonts?.ready?.then(remesurer);
  // La hauteur des écrans change quand on ouvre l'introduction ou qu'on change d'onglet du parcours
  if ('ResizeObserver' in window) {
    const surveillance = new ResizeObserver(remesurer);
    ecrans.forEach((e) => surveillance.observe(e));
  }

  // ——— Liens internes (menu, repères, « Découvrir mes travaux »…) ———
  // Les écrans sont collés (sticky) : une fois en bas de page, ils sont tous « en haut de l'écran »
  // aux yeux du navigateur, qui croit donc qu'il n'y a pas à défiler pour les atteindre.
  // On calcule nous-mêmes la position de l'écran visé dans le flux de la page.
  if (empile) {
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const lien = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[href*="#"]');
      if (!lien || (lien.target && lien.target !== '_self') || lien.hasAttribute('download')) return;

      const url = new URL(lien.href, location.href);
      if (url.origin !== location.origin || url.pathname !== location.pathname || url.hash.length < 2) return;

      const cible = document.getElementById(decodeURIComponent(url.hash.slice(1)));
      const i = cible ? ecrans.findIndex((ecran) => ecran.contains(cible)) : -1;
      if (i < 0) return;

      e.preventDefault();
      if (location.hash !== url.hash) history.pushState(null, '', url.hash);

      mesurer();
      window.scrollTo({ top: plages[i].debut, behavior: 'smooth' });

      // Le focus suit (lecteurs d'écran, touche Tab), sans provoquer de défilement
      const ecran = ecrans[i];
      if (!ecran.hasAttribute('tabindex')) ecran.setAttribute('tabindex', '-1');
      ecran.focus({ preventScroll: true });
    });
  }

  // ——— Aimantation : une page s'affiche toujours en entier ———
  // Quand le défilement s'arrête entre deux pages, on termine le mouvement en douceur
  // vers la page la plus proche, dans le sens du défilement. Les pages plus hautes que
  // la fenêtre peuvent être lues librement d'un bout à l'autre.
  if (empile) {
    let dernierY = window.scrollY;
    let sens = 0;
    let doigtPose = false;
    let attenteAimant = 0;

    const aimanter = () => {
      if (doigtPose) return;
      const y = window.scrollY;
      // Déjà sur une position de lecture : rien à faire
      if (plages.some((p) => y >= p.debut - 2 && y <= p.fin + 2)) return;
      // Entre la fin d'une page et le début de la suivante
      const i = plages.findIndex((p, k) => k < plages.length - 1 && y > p.fin && y < plages[k + 1].debut);
      if (i < 0) return;
      const avant = plages[i].fin;
      const apres = plages[i + 1].debut;
      const progression = (y - avant) / (apres - avant);
      // Un petit élan suffit à passer à la page suivante (ou à revenir)
      const cible = sens > 0 ? (progression > 0.12 ? apres : avant) : sens < 0 ? (progression < 0.88 ? avant : apres) : progression > 0.5 ? apres : avant;
      window.scrollTo({ top: cible, behavior: 'smooth' });
    };

    // On attend la vraie fin du mouvement (inertie du pavé tactile ou du doigt comprise)
    // pour ne pas se battre avec l'utilisateur.
    const programmer = (delai: number) => {
      window.clearTimeout(attenteAimant);
      attenteAimant = window.setTimeout(aimanter, delai);
    };

    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        if (y !== dernierY) sens = y > dernierY ? 1 : -1;
        dernierY = y;
        programmer(220);
      },
      { passive: true },
    );
    // Navigateurs récents : l'évènement « fin de défilement » est plus fiable qu'un minuteur
    if ('onscrollend' in window) window.addEventListener('scrollend', () => programmer(60));
    window.addEventListener('wheel', () => programmer(220), { passive: true });
    window.addEventListener('touchstart', () => {
      doigtPose = true;
      window.clearTimeout(attenteAimant);
    }, { passive: true });
    const lever = () => {
      doigtPose = false;
      programmer(220);
    };
    window.addEventListener('touchend', lever, { passive: true });
    window.addEventListener('touchcancel', lever, { passive: true });
  }
</script>

<style>
  /* ——— Repères latéraux ——— */
