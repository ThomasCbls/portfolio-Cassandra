  .initiales {
    font-family: var(--f-script);
    font-size: clamp(5rem, 14vw, 9rem);
    line-height: 1;
    color: var(--or-clair);
    text-shadow: 0 0 40px rgba(236, 217, 168, 0.25);
    padding-right: 0.15em;
    transition: text-shadow 500ms ease;
  }

  /* Ondes dorées qui invitent au clic */
  .medaillon-onde {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--or-clair);
    opacity: 0;
    pointer-events: none;
  }

  /* Invitation sous le médaillon */
  .invitation {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: clamp(1.75rem, 5vh, 2.75rem);
    font-size: 0.7rem;
