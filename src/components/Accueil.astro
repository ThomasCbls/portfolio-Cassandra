  /* Médaillon : un bouton tant que l'introduction est fermée */
  .medaillon-zone {
    position: relative;
    justify-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100%, 23rem);
  }

  .medaillon {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    border-radius: 50%;
    transform-origin: center;
  }

  .ouverte .medaillon {
    cursor: default;
  }

  .medaillon:focus-visible {
    outline: none;
  }

  .medaillon:focus-visible .medaillon-cadre {
    box-shadow:
      0 0 0 6px var(--carte),
      0 0 0 8px var(--or-clair),
      0 30px 60px -20px rgba(0, 0, 0, 0.8);
