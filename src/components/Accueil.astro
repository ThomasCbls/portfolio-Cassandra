  }

  .invitation-trait:last-child {
    background: linear-gradient(90deg, var(--or), transparent);
  }

  .sur-tactile {
    display: none;
  }

  @media (hover: none) {
    .sur-souris {
      display: none;
    }

    .sur-tactile {
      display: inline;
    }
  }

  /* ——— État fermé (avec JavaScript seulement) : les initiales seules, au centre ——— */
  :global(.js) .ouverture:not(.ouverte) .ouverture-grille {
    grid-template-columns: 1fr;
    justify-items: center;
  }

  :global(.js) .ouverture:not(.ouverte) .ouverture-texte {
    display: none;
  }

  :global(.js) .ouverture:not(.ouverte) .medaillon-zone {
    width: min(78vw, 25rem, 39vh);
  }

  :global(.js) .ouverture:not(.ouverte) .medaillon:hover .medaillon-cadre {
    box-shadow:
      0 0 0 6px var(--carte),
      0 0 0 7px var(--or),
      0 0 60px -6px rgba(236, 217, 168, 0.35),
      0 30px 60px -20px rgba(0, 0, 0, 0.8);
  }

  :global(.js) .ouverture:not(.ouverte) .medaillon:hover .monogramme {
    filter: brightness(1.15) drop-shadow(0 0 18px rgba(236, 217, 168, 0.25));
  }

  .monogramme {
    transition: filter 500ms ease;
  }

  :global(html:not(.js)) .invitation,
  .ouverte .invitation {
    display: none;
  }

  :global(.js) .ouverture:not(.ouverte) .defiler {
    opacity: 0;
    pointer-events: none;
  }

  .defiler {
    transition: opacity 800ms ease 1.6s;
  }

  .sans-animation .defiler {
    transition: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Respiration lente du médaillon et ondes qui s'en échappent */
    :global(.js) .ouverture:not(.ouverte) .medaillon {
      animation: respirer 3.2s ease-in-out infinite;
    }

    :global(.js) .ouverture:not(.ouverte) .medaillon-onde {
      animation: onde 3.2s cubic-bezier(0.2, 0.7, 0.2, 1) infinite;
    }

    :global(.js) .ouverture:not(.ouverte) .medaillon-onde-2 {
      animation-delay: 1.6s;
    }

    :global(.js) .ouverture:not(.ouverte) .invitation {
      animation: inviter 3.2s ease-in-out infinite;
    }

    @keyframes respirer {
      50% {
        transform: scale(1.025);
      }
    }

    @keyframes onde {
      0% {
        opacity: 0.6;
        transform: scale(1);
      }
      100% {
        opacity: 0;
        transform: scale(1.22);
      }
    }

    @keyframes inviter {
      0%,
      100% {
        opacity: 0.55;
      }
      50% {
        opacity: 1;
      }
    }

    /* Au clic : un éclat d'or part du médaillon */
    .eclat .medaillon-onde {
      animation: eclat 1100ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .eclat .medaillon-onde-2 {
      animation-delay: 140ms;
    }

    @keyframes eclat {
      0% {
        opacity: 0.9;
        transform: scale(1);
        border-width: 2px;
      }
      100% {
        opacity: 0;
        transform: scale(1.6);
        border-width: 1px;
      }
    }

    /* Le texte de l'introduction surgit ligne à ligne */
    .ouverte:not(.sans-animation) .ouverture-texte > * {
      animation: surgir 1100ms cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
      animation-delay: calc(550ms + var(--i) * 140ms);
    }

    .ouverte:not(.sans-animation) .ouverture-texte > .filet {
      animation-name: deplier;
      transform-origin: left center;
    }

    @keyframes surgir {
      from {
        opacity: 0;
        transform: translateY(1.75rem);
        filter: blur(6px);
      }
    }

    @keyframes deplier {
      from {
        opacity: 0;
        transform: scaleX(0);
      }
    }
  }

  .devise {
    font-size: 0.6875rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gris-or);
  }

  /* Invitation à défiler */
  /* Sous le médaillon, dans la colonne de droite */
  .defiler {
    position: absolute;
    right: calc(var(--gouttiere) + 5rem + min(100% - 2 * (var(--gouttiere) + 5rem), var(--largeur)) * 0.2);
