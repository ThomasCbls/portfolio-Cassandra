---
// Monogramme du médaillon d'accueil : initiales dorées entrelacées dans une couronne de laurier,
// avec une inscription qui court le long de l'ovale, comme sur une médaille ou un ex-libris.
interface Props {
  initiales: string;
  inscription: string;
  annee: string;
}

const { initiales, inscription, annee } = Astro.props;
const [premiere = '', seconde = ''] = [...initiales];

// Couronne de laurier : une branche calculée le long d'un arc, l'autre en miroir
const cx = 150;
const cy = 212;
const r = 92;
const rad = (d: number) => (d * Math.PI) / 180;
const point = (deg: number, rayon = r) => [cx + rayon * Math.cos(rad(deg)), cy + rayon * Math.sin(rad(deg))];

const debut = 100; // près du bas
const fin = 232; // vers le haut, côté gauche
const tige = (() => {
  const pts = [];
  for (let d = debut; d <= fin; d += 4) pts.push(point(d));
  return 'M' + pts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join(' L');
})();

// Une feuille pointe le long de +x ; on l'oriente selon la tangente de la branche
const feuille = 'M0 0C4.5-4.8 12.5-5.2 17 0C12.5 5.2 4.5 4.8 0 0Z';
const feuilles: { x: number; y: number; angle: number; echelle: number }[] = [];
for (let d = debut + 6; d <= fin; d += 11) {
  const [x, y] = point(d);
  const tangente = d + 90; // direction de la pointe de la branche
  const echelle = 1.05 - ((d - debut) / (fin - debut)) * 0.45;
  feuilles.push({ x, y, angle: tangente - 38, echelle });
  feuilles.push({ x, y, angle: tangente + 38, echelle });
}
const [bx, by] = point(fin + 6, r);
---

<svg class="monogramme-svg" viewBox="0 0 300 400" role="img" aria-label={`Monogramme ${initiales}`}>
  <defs>
    <linearGradient id="mono-or" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f8ebc8"></stop>
      <stop offset="0.45" stop-color="#e2c68e"></stop>
      <stop offset="1" stop-color="#a8844b"></stop>
    </linearGradient>
    <radialGradient id="mono-lueur" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#ecd9a8" stop-opacity="0.22"></stop>
      <stop offset="1" stop-color="#ecd9a8" stop-opacity="0"></stop>
    </radialGradient>
    <filter id="mono-halo" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="6"></feGaussianBlur>
    </filter>
    <!-- Ovale de l'inscription, parcouru dans le sens des aiguilles d'une montre depuis le haut -->
    <path id="mono-anneau" d="M150 22A128 178 0 1 1 149.99 22"></path>
  </defs>

  <!-- Lueur derrière les initiales -->
  <ellipse cx="150" cy="205" rx="105" ry="120" fill="url(#mono-lueur)"></ellipse>

  <!-- Inscription circulaire et filets -->
  <text class="mono-inscription">
    <textPath href="#mono-anneau" textLength="928" lengthAdjust="spacing">{inscription}</textPath>
  </text>
  <ellipse cx="150" cy="200" rx="117" ry="167" class="mono-filet"></ellipse>
  <ellipse cx="150" cy="200" rx="113" ry="163" class="mono-filet mono-filet-pale"></ellipse>

  <!-- Étoile au sommet -->
  <path class="mono-plein" d="M150 92l3 9 9 3-9 3-3 9-3-9-9-3 9-3z"></path>
  <path class="mono-trait" d="M126 104h12M162 104h12"></path>

  <!-- Couronne de laurier -->
  <g class="mono-laurier">
    <g>
      <path class="mono-tige" d={tige}></path>
      {feuilles.map((f) => <path d={feuille} transform={`translate(${f.x.toFixed(1)} ${f.y.toFixed(1)}) rotate(${f.angle.toFixed(1)}) scale(${f.echelle.toFixed(2)})`} />)}
      <circle cx={bx.toFixed(1)} cy={by.toFixed(1)} r="2.2"></circle>
    </g>
    <g transform="translate(300 0) scale(-1 1)">
      <path class="mono-tige" d={tige}></path>
      {feuilles.map((f) => <path d={feuille} transform={`translate(${f.x.toFixed(1)} ${f.y.toFixed(1)}) rotate(${f.angle.toFixed(1)}) scale(${f.echelle.toFixed(2)})`} />)}
      <circle cx={bx.toFixed(1)} cy={by.toFixed(1)} r="2.2"></circle>
    </g>
    <!-- Nœud de ruban au bas de la couronne -->
    <path class="mono-tige" d="M150 306c-7-6-15-6-15 0s8 6 15 0c7 6 15 6 15 0s-8-6-15 0z"></path>
    <path class="mono-tige" d="M147 307l-7 14M153 307l7 14"></path>
  </g>

  <!-- Initiales entrelacées -->
  <g class="mono-initiales">
    <text x="124" y="234" class="mono-lettre mono-halo" filter="url(#mono-halo)">{premiere}</text>
    <text x="128" y="248" class="mono-lettre mono-halo" filter="url(#mono-halo)">{seconde}</text>
    <text x="124" y="234" class="mono-lettre">{premiere}</text>
    <text x="128" y="248" class="mono-lettre">{seconde}</text>
  </g>

  <!-- Année en chiffres romains -->
  <text x="150" y="348" class="mono-annee">{annee}</text>
</svg>

<style>
  .monogramme-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .mono-inscription {
    font-family: var(--f-texte);
    font-size: 10.5px;
    letter-spacing: 0.5px;
    fill: var(--gris-or);
    text-transform: uppercase;
  }

  .mono-filet {
    fill: none;
    stroke: var(--or);
    stroke-width: 0.8;
    opacity: 0.55;
  }

  .mono-filet-pale {
    opacity: 0.22;
  }

  .mono-plein {
    fill: var(--or-clair);
  }

  .mono-trait {
    stroke: var(--or);
    stroke-width: 0.8;
    opacity: 0.7;
  }

  .mono-laurier {
    fill: url(#mono-or);
    opacity: 0.85;
  }

  .mono-tige {
    fill: none;
    stroke: url(#mono-or);
    stroke-width: 1.1;
    stroke-linecap: round;
  }

  .mono-lettre {
    font-family: var(--f-script);
    font-size: 112px;
    text-anchor: middle;
    fill: url(#mono-or);
  }

  .mono-halo {
    fill: #ecd9a8;
    opacity: 0.35;
  }

  .mono-annee {
    font-family: var(--f-texte);
    font-size: 11px;
    letter-spacing: 4px;
    text-anchor: middle;
    fill: var(--gris-or);
  }
</style>
