---
// Ambiance de la page :
//  - fond animé : poussière dorée en suspension et halos de lumière qui dérivent ;
//  - curseur doux : un point qui suit la souris et un anneau qui le rattrape.
// Rien de tout cela sur écran tactile pour le curseur, ni avec « réduire les animations ».
---

<div class="ambiance" aria-hidden="true">
  <span class="halo halo-or"></span>
  <span class="halo halo-braise"></span>
  <canvas class="poussiere"></canvas>
</div>

<div class="curseur" aria-hidden="true">
  <span class="curseur-anneau"><span class="curseur-texte"></span></span>
  <span class="curseur-point"></span>
</div>

<script>
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const racine = document.documentElement;

  // Lissage indépendant de la fréquence de l'écran (60 Hz, 120 Hz…) : k est donné pour 60 images/s
  const lisser = (k: number, pas: number) => 1 - Math.pow(1 - k, pas);

  /* ——— Poussière dorée ——— */
  const toile = document.querySelector<HTMLCanvasElement>('.poussiere');
  const ctx = toile?.getContext('2d', { alpha: true });

  if (toile && ctx && !reduit) {
    interface Grain {
      x: number;
      y: number;
      r: number;
      vx: number;
      vy: number;
      phase: number;
      profondeur: number;
      alpha: number;
    }

    let largeur = 0;
    let hauteur = 0;
    let grains: Grain[] = [];
    const souris = { x: -9999, y: -9999, px: 0, py: 0 };

    const nouveau = (): Grain => {
      const profondeur = Math.random();
      return {
        x: Math.random() * largeur,
        y: Math.random() * hauteur,
        r: 0.4 + profondeur * 1.7,
        vx: (Math.random() - 0.5) * 0.02,
        vy: -(0.015 + profondeur * 0.07),
        phase: Math.random() * Math.PI * 2,
        profondeur,
        alpha: 0.25 + profondeur * 0.6,
      };
    };

    // Grains très fins et flous : une définition simple suffit, et coûte 4 à 9 fois moins
    // à redessiner qu'en pleine résolution sur les écrans Retina / téléphones.
    const tactile = window.matchMedia('(hover: none), (pointer: coarse)').matches;
    const plafond = tactile ? 45 : 110;

    const redimensionner = () => {
      const l = window.innerWidth;
      // Sur téléphone, la barre d'adresse qui apparaît / disparaît change la hauteur à chaque défilement :
      // on ne redimensionne que si la largeur change ou si la fenêtre grandit.
      const h = Math.max(window.innerHeight, hauteur);
      if (l === largeur && h === hauteur) return;
      const nouvelleLargeur = l !== largeur;
      largeur = l;
      hauteur = h;
      toile.width = largeur;
      toile.height = hauteur;
      toile.style.width = `${largeur}px`;
      toile.style.height = `${hauteur}px`;
      if (nouvelleLargeur || grains.length === 0) {
        const nombre = Math.round(Math.min(plafond, (largeur * hauteur) / 13000));
        grains = Array.from({ length: nombre }, nouveau);
      }
    };

    redimensionner();
    let attenteTaille = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(attenteTaille);
      attenteTaille = requestAnimationFrame(redimensionner);
    });
    window.addEventListener(
      'pointermove',
      (e) => {
        souris.x = e.clientX;
        souris.y = e.clientY;
      },
      { passive: true },
    );

    // Couleurs des grains : or pâle sur fond sombre, encre sépia sur le vélin du thème clair
    let couleurs = { halo: '#ecd9a8', proche: '#f6e7c1', loin: '#d9bd85', force: 1 };
    const lireTheme = () => {
      couleurs =
        racine.dataset.theme === 'clair'
          ? { halo: '#a8823f', proche: '#7a5a26', loin: '#9c7a3e', force: 0.75 }
          : { halo: '#ecd9a8', proche: '#f6e7c1', loin: '#d9bd85', force: 1 };
    };
    lireTheme();
    window.addEventListener('changement-theme', lireTheme);

    let temps = 0;
    let dernierDefilement = window.scrollY;
    let elan = 0;
    let anim = 0;
    let derniereImage = 0;

    const dessiner = (maintenant: number) => {
      anim = requestAnimationFrame(dessiner);
      // Rien à dessiner tant que le chargeur couvre la page
      if (racine.classList.contains('chargement')) {
        derniereImage = maintenant;
        return;
      }

      // Pas de temps en « images à 60 Hz » : même vitesse sur tous les écrans
      const pas = derniereImage ? Math.min(3, (maintenant - derniereImage) / 16.667) : 1;
      derniereImage = maintenant;
      temps += pas;

      // Le défilement souffle légèrement sur la poussière
      const delta = window.scrollY - dernierDefilement;
      dernierDefilement = window.scrollY;
      elan += (delta / pas - elan) * lisser(0.08, pas);

      // Parallaxe douce selon la position de la souris
      const cibleX = souris.x < -999 ? 0 : souris.x - largeur / 2;
      const cibleY = souris.y < -999 ? 0 : souris.y - hauteur / 2;
      const k = lisser(0.03, pas);
      souris.px += (cibleX - souris.px) * k;
      souris.py += (cibleY - souris.py) * k;

      ctx.clearRect(0, 0, largeur, hauteur);

      for (const g of grains) {
        g.x += (g.vx + Math.sin(temps * 0.0025 + g.phase) * 0.035 * g.profondeur) * pas;
        g.y += (g.vy - elan * 0.06 * g.profondeur) * pas;

        // Les grains s'écartent doucement du curseur
        const dx = g.x - souris.x;
        const dy = g.y - souris.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < 16900 && d2 > 0.0001) {
          const d = Math.sqrt(d2);
          const force = (1 - d / 130) * 0.9 * (0.3 + g.profondeur) * pas;
          g.x += (dx / d) * force;
          g.y += (dy / d) * force;
        }

        if (g.y < -12) {
          g.y = hauteur + 12;
          g.x = Math.random() * largeur;
        } else if (g.y > hauteur + 12) g.y = -12;
        if (g.x < -12) g.x = largeur + 12;
        else if (g.x > largeur + 12) g.x = -12;

        const x = g.x - souris.px * 0.025 * g.profondeur;
        const y = g.y - souris.py * 0.025 * g.profondeur;
        const scintille = 0.55 + 0.45 * Math.sin(temps * 0.012 + g.phase * 3);

        // Halo autour des grains les plus proches
        if (g.profondeur > 0.75) {
          ctx.globalAlpha = g.alpha * scintille * 0.12 * couleurs.force;
          ctx.fillStyle = couleurs.halo;
          ctx.beginPath();
          ctx.arc(x, y, g.r * 4.5, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.globalAlpha = g.alpha * scintille * couleurs.force;
        ctx.fillStyle = g.profondeur > 0.9 ? couleurs.proche : couleurs.loin;
        ctx.beginPath();
        ctx.arc(x, y, g.r, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    anim = requestAnimationFrame(dessiner);

    // Pause quand l'onglet n'est pas visible
    document.addEventListener('visibilitychange', () => {
      cancelAnimationFrame(anim);
      derniereImage = 0;
      if (!document.hidden) anim = requestAnimationFrame(dessiner);
    });
  }

  /* ——— Curseur doux ——— */
  const souris = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const curseur = document.querySelector<HTMLElement>('.curseur');
  const anneau = document.querySelector<HTMLElement>('.curseur-anneau');
  const point = document.querySelector<HTMLElement>('.curseur-point');
  const texte = document.querySelector<HTMLElement>('.curseur-texte');

  if (souris && !reduit && curseur && anneau && point && texte) {
    document.documentElement.classList.add('curseur-actif');

    let x = -100;
    let y = -100;
    let ax = x;
    let ay = y;
    let visible = false;
    let enMouvement = false;
    let derniereImage = 0;

    // L'anneau rattrape le point ; la boucle s'arrête d'elle-même quand il l'a rejoint
    const suivre = (maintenant: number) => {
      const pas = derniereImage ? Math.min(3, (maintenant - derniereImage) / 16.667) : 1;
      derniereImage = maintenant;
      const k = lisser(0.16, pas);
      ax += (x - ax) * k;
      ay += (y - ay) * k;
      const arrive = Math.abs(x - ax) < 0.15 && Math.abs(y - ay) < 0.15;
      if (arrive) {
        ax = x;
        ay = y;
      }
      point.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      anneau.style.transform = `translate3d(${ax}px, ${ay}px, 0)`;
      if (arrive) {
        enMouvement = false;
        derniereImage = 0;
      } else requestAnimationFrame(suivre);
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        x = e.clientX;
        y = e.clientY;
        if (!visible) {
          visible = true;
          ax = x;
          ay = y;
          curseur.classList.add('visible');
        }
        if (!enMouvement) {
          enMouvement = true;
          requestAnimationFrame(suivre);
        }
      },
      { passive: true },
    );

    document.documentElement.addEventListener('pointerleave', () => {
      visible = false;
      curseur.classList.remove('visible');
    });

    // Au survol d'un lien ou d'un bouton, l'anneau s'ouvre ;
    // un élément [data-curseur="…"] affiche un mot dans l'anneau.
    document.addEventListener('pointerover', (e) => {
      const cible = (e.target as HTMLElement).closest<HTMLElement>(
        'a, button, [role="tab"], [data-curseur], label, summary',
      );
      const mot = cible?.closest<HTMLElement>('[data-curseur]')?.dataset.curseur;
      const surLien = !!cible && !cible.matches('[data-curseur]');
      curseur.classList.toggle('survol', surLien);
      curseur.classList.toggle('mot', !!mot && !surLien);
      texte.textContent = mot && !surLien ? mot : '';
    });

    window.addEventListener('pointerdown', () => curseur.classList.add('appui'));
    window.addEventListener('pointerup', () => curseur.classList.remove('appui'));
  }
</script>

<style>
  /* ——— Fond animé ——— */
  /* Au-dessus des écrans (opaques) mais sous l'en-tête et le curseur */
  .ambiance {
    position: fixed;
    inset: 0;
    z-index: 20;
    overflow: hidden;
    pointer-events: none;
  }

  .poussiere {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* Le dégradé radial est déjà fondu : pas besoin de flou ni de mode de fusion,
     très coûteux à recalculer à chaque image au-dessus d'une page qui défile. */
  .halo {
    position: absolute;
    border-radius: 50%;
    opacity: 0.7;
    will-change: transform;
  }

  .halo-or {
    width: 60vmax;
    height: 60vmax;
    left: -15vmax;
    top: -20vmax;
    background: radial-gradient(circle, rgba(201, 150, 80, 0.2), transparent 65%);
  }

  .halo-braise {
    width: 55vmax;
    height: 55vmax;
    right: -20vmax;
    bottom: -25vmax;
    background: radial-gradient(circle, rgba(150, 60, 40, 0.16), transparent 65%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .halo-or {
      animation: deriver-or 38s ease-in-out infinite alternate;
    }

    .halo-braise {
      animation: deriver-braise 46s ease-in-out infinite alternate;
    }

    @keyframes deriver-or {
      50% {
        transform: translate(35vw, 25vh) scale(1.15);
      }
      100% {
        transform: translate(15vw, 55vh) scale(0.9);
      }
    }

    @keyframes deriver-braise {
      50% {
        transform: translate(-30vw, -30vh) scale(1.2);
      }
      100% {
        transform: translate(-55vw, -10vh) scale(0.95);
      }
    }
  }

  :global(html[data-theme='clair']) .halo {
    opacity: 0.35;
  }

  /* ——— Curseur ——— */
  .curseur {
    display: none;
  }

  /* Une fenêtre (livre ouvert) passe au-dessus de tout, curseur doré compris :
     on rend la main au curseur du système tant qu'elle est ouverte */
  :global(html.curseur-actif:has(dialog[open])) .curseur {
    visibility: hidden;
  }

  :global(html.curseur-actif dialog[open]),
  :global(html.curseur-actif dialog[open] *) {
    cursor: revert !important;
  }

  :global(html.curseur-actif) .curseur {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  :global(html.curseur-actif) .curseur.visible {
    opacity: 1;
  }

  :global(html.curseur-actif),
  :global(html.curseur-actif *) {
    cursor: none !important;
  }

  .curseur-point,
  .curseur-anneau {
    position: absolute;
    top: 0;
    left: 0;
    will-change: transform;
  }

  .curseur-point::before {
    content: '';
    position: absolute;
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    border-radius: 50%;
    background: var(--or-clair);
    box-shadow: 0 0 10px rgba(236, 217, 168, 0.6);
    transition: transform 250ms ease;
  }

  .curseur-anneau::before {
    content: '';
    position: absolute;
    width: 2.25rem;
    height: 2.25rem;
    margin: -1.125rem 0 0 -1.125rem;
    border-radius: 50%;
    border: 1px solid rgba(236, 217, 168, 0.55);
    transition:
      transform 350ms cubic-bezier(0.2, 0.7, 0.2, 1),
      background-color 300ms ease,
      border-color 300ms ease;
  }

  .curseur-texte {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -50%;
    font-family: var(--f-texte);
    font-size: 0.55rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--or-clair);
    text-shadow: 0 0 6px rgba(13, 11, 8, 0.9);
    opacity: 0;
    transition: opacity 250ms ease;
  }

  /* Survol d'un lien : l'anneau s'ouvre et se teinte */
  .curseur.survol .curseur-anneau::before {
    transform: scale(1.7);
    background: rgba(236, 217, 168, 0.08);
    border-color: var(--or);
  }

  .curseur.survol .curseur-point::before {
    transform: scale(0.5);
  }

  /* Mot dans l'anneau (ex. « Glisser » sur le carrousel) */
  .curseur.mot .curseur-anneau::before {
    transform: scale(1.9);
    background: rgba(13, 11, 8, 0.18);
    border-color: var(--or-clair);
  }

  .curseur.mot .curseur-texte {
    opacity: 1;
  }

  .curseur.mot .curseur-point::before {
    transform: scale(0);
  }

  .curseur.appui .curseur-anneau::before {
    transform: scale(0.8);
  }

  .curseur.survol.appui .curseur-anneau::before {
    transform: scale(1.4);
  }
</style>
