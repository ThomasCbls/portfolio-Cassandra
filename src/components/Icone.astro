---
// Pictogrammes au trait, dans l'esprit des gravures : un seul trait fin, doré.
// Chaque tracé a pathLength="1" pour pouvoir être « dessiné » en CSS.
interface Props {
  nom: string;
  class?: string;
}

const { nom, class: classe } = Astro.props;

const cercle = (cx: number, cy: number, r: number) =>
  `M${cx - r} ${cy}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 ${-2 * r} 0`;

const traces: Record<string, string[]> = {
  // Plume d'oie et trait d'encre : paléographie
  plume: [
    'M20 3c-6 0-11.5 4.5-12.5 11.5',
    'M20 3c0 6-4.5 10.5-11.5 11.5',
    'M16 7 5 19',
    'M5 19l-1.5 2',
    'M10 21h11',
  ],
  // Fronton et colonnes : latin
  colonnes: [
    'M3 9.5 12 4l9 5.5',
    'M4 9.5h16',
    'M6.5 12v6',
    'M10.5 12v6',
    'M13.5 12v6',
    'M17.5 12v6',
    'M4.5 18.5h15',
    'M3 21h18',
  ],
  // Acte scellé : fonds notariaux
  sceau: [
    'M14 3H6v18h7',
    'M14 3l4 4v5',
    'M14 3v4h4',
    'M9 9h6',
    'M9 12h5',
    'M9 15h2.5',
    cercle(17, 17, 3),
    'M15.5 19.6 14.6 22.5',
    'M18.5 19.6l.9 2.9',
  ],
  // Lignes de manuscrit et loupe : transcription
  loupe: ['M4 5h12', 'M4 8.5h9', 'M4 12h5', 'M4 15.5h4', cercle(15, 15, 4), 'M18 18l3 3'],
  // Carte pliée et repère : cartographie
  carte: [
    'M3 6.5 9 4l6 2.5L21 4v13.5L15 20l-6-2.5L3 20z',
    'M9 4v13.5',
    'M15 6.5V20',
    'M12 13.5c-1.2-1.4-1.8-2.4-1.8-3.2a1.8 1.8 0 0 1 3.6 0c0 .8-.6 1.8-1.8 3.2z',
  ],
  // Rayonnage : bibliographie
  livres: [
    'M4 4h4v16H4z',
    'M9 7h4v13H9z',
    'M14.2 6.2l3.8-1 3.6 13.7-3.8 1z',
    'M4 8h4',
    'M4 16h4',
    'M9 10.5h4',
  ],
  // Livre ouvert : médiation
  'livre-ouvert': [
    'M12 6.5C10 5 7 4.5 3.5 5v13c3.5-.5 6.5 0 8.5 1.5',
    'M12 6.5C14 5 17 4.5 20.5 5v13c-3.5-.5-6.5 0-8.5 1.5',
    'M12 6.5v13',
    'M6 8.5c1.5-.2 2.8 0 4 .5',
    'M6 11.5c1.5-.2 2.8 0 4 .5',
    'M14 9c1.2-.5 2.5-.7 4-.5',
    'M14 12c1.2-.5 2.5-.7 4-.5',
  ],
  // Losange : par défaut
  losange: ['M12 3l9 9-9 9-9-9z', 'M12 8l4 4-4 4-4-4z'],
};

const chemins = traces[nom] ?? traces.losange;
---

<svg class:list={['icone', classe]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {chemins.map((d, i) => <path d={d} pathLength="1" style={`--n: ${i}`} />)}
</svg>

<style>
  .icone {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
</style>
