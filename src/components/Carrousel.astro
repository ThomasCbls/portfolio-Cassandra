---
// Carrousel plein écran des travaux : une diapositive par travail.
// Sans JavaScript, les diapositives s'affichent simplement les unes sous les autres.
import type { Travail } from '../data/travaux';
import { lien, t, type Langue } from '../i18n';

interface Props {
  travaux: Travail[];
  lang: Langue;
}

const { travaux, lang } = Astro.props;
const tx = t(lang).carrousel;
const chapitre = t(lang).chapitre;
const total = travaux.length;
const deux = (n: number) => String(n).padStart(2, '0');

const romain = (n: number) => {
  const table: [number, string][] = [
    [10, 'X'],
    [9, 'IX'],
    [5, 'V'],
    [4, 'IV'],
    [1, 'I'],
  ];
  let s = '';
  for (const [v, c] of table)
    while (n >= v) {
      s += c;
      n -= v;
    }
  return s;
};

const siecles = (debut: number, fin: number) => {
  const a = Math.floor(debut / 100) + 1;
  const b = Math.floor(fin / 100) + 1;
  return a === b ? [a] : [a, b];
};

// Anglais : « 2nd century », « 2nd – 3rd centuries »
const ordinal = (n: number) => {
  const r = n % 100;
  const suffixe = r >= 11 && r <= 13 ? 'th' : ['th', 'st', 'nd', 'rd'][n % 10] ?? 'th';
  return `${n}${suffixe ?? 'th'}`;
};
---

<section
  id="travaux"
  class="ecran carrousel"
  aria-roledescription={tx.role}
  aria-labelledby="titre-travaux"
  style={`--total: ${total}`}
  data-annonce={tx.annonce}
>
  <div class="contenu carrousel-entete" data-reveal>
    <div>
      <p class="surtitre"><span class="chapitre">{chapitre} III</span> {tx.surtitre}</p>
      <h2 id="titre-travaux" class="titre-section">{tx.titre}</h2>
    </div>
    <p class="compteur" aria-hidden="true">
      <span class="compteur-actuel">01</span>
      <span class="compteur-trait"></span>
      <span class="compteur-total">{deux(total)}</span>
    </p>
  </div>

  <div class="diapos" data-reveal data-curseur={tx.glisser}>
    {
      travaux.map((t, i) => {
        const d = t.data;
        const s = d.debut !== undefined && d.fin !== undefined ? siecles(d.debut, d.fin) : null;
        // Grande année en filigrane : début de la période étudiée, sinon année de réalisation
        const filigrane = d.debut ?? String(d.annee ?? '').match(/\d{4}/)?.[0] ?? deux(i + 1);
        return (
          <article
            class:list={['diapo', { active: i === 0, 'en-cours': d.enCours, illustree: !!d.gravure }]}
            role="group"
            aria-roledescription={tx.diapositive}
            aria-label={tx.position(i + 1, total, d.titre)}
          >
            {d.gravure && <span class="diapo-fond" aria-hidden="true" style={`background-image: url('${d.gravure}')`} />}
            <span class="filigrane" aria-hidden="true">
              {filigrane}
            </span>

            <div class="diapo-texte">
              <p class="diapo-meta anime" style="--i: 0">
                <span>{d.nature}</span>
                {d.annee && (
                  <>
                    <span class="point" aria-hidden="true" />
                    <span>{d.annee}</span>
                  </>
                )}
                {d.enCours && <span class="badge">{tx.enCours}</span>}
              </p>
              <h3 class="diapo-titre anime" style="--i: 1">
                <a href={lien(lang, `/travaux/${t.id}/`)}>{d.titre}</a>
              </h3>
              {d.sousTitre && (
                <p class="diapo-sous-titre anime" style="--i: 2">
                  {d.sousTitre}
                </p>
              )}
              <p class="diapo-resume lettrine anime" style="--i: 3">
                {d.resume}
              </p>
              {d.sources.length > 0 && (
                <ul class="diapo-sources anime" style="--i: 4" aria-label={tx.sources}>
                  {d.sources.map((src) => (
                    <li>
                      <span class="cote">{src.cote}</span>
                      <span>{src.fonds}</span>
                    </li>
                  ))}
                </ul>
              )}
              <p class="anime" style="--i: 5">
                <a class="bouton bouton-plein" href={lien(lang, `/travaux/${t.id}/`)}>
                  {tx.lire} <span aria-hidden="true">→</span>
                </a>
              </p>
            </div>

            <div class="diapo-medaillon" aria-hidden="true">
              {
                d.gravure ? (
                  <div class="ovale ovale-gravure objet-sombre" data-loupe data-curseur="">
                    <img src={d.gravure} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                    <span class="ovale-pastille">{deux(i + 1)}</span>
                  </div>
                ) : (
                  <div class="ovale objet-sombre">
                    <span class="ovale-numero">{deux(i + 1)}</span>
                    {d.debut !== undefined && d.fin !== undefined ? (
                      <span class="ovale-periode">
                        <span>{d.debut}</span>
                        <span class="losange" />
                        <span>{d.fin}</span>
                      </span>
                    ) : (
                      d.annee && <span class="ovale-periode">{d.annee}</span>
                    )}
                    {s && lang === 'en' && (
                      <span class="ovale-siecle">
                        {s.map(ordinal).join(' – ')} centur{s[1] ? 'ies' : 'y'}
                      </span>
                    )}
                    {s && lang === 'fr' && (
                      <span class="ovale-siecle">
                        {romain(s[0])}
                        <sup>e</sup>
                        {s[1] && (
                          <>
                            {' '}– {romain(s[1])}
                            <sup>e</sup>
                          </>
                        )}{' '}
                        siècle{s[1] ? 's' : ''}
                      </span>
                    )}
                  </div>
                )
              }
              {d.credit && <p class="credit">{d.credit}</p>}
            </div>
          </article>
        );
      })
    }
  </div>

  <div class="contenu carrousel-pied">
    <ol class="progression">
      {
        travaux.map((t, i) => (
          <li>
            <button
              type="button"
              class="segment"
              data-cible={i}
              aria-label={tx.travail(i + 1, t.data.titre)}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span class="segment-num">{deux(i + 1)}</span>
              <span class="segment-titre">{t.data.titre}</span>
              <span class="segment-barre">
                <span />
              </span>
            </button>
          </li>
        ))
      }
    </ol>
    <div class="fleches">
      <button type="button" class="fleche-btn precedent" aria-label={tx.precedent}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button type="button" class="fleche-btn suivant" aria-label={tx.suivant}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>

  <p class="annonce visuellement-cache" aria-live="polite"></p>
</section>

<script>
  const carrousel = document.querySelector<HTMLElement>('.carrousel');

  if (carrousel) {
    const diapos = [...carrousel.querySelectorAll<HTMLElement>('.diapo')];
    const segments = [...carrousel.querySelectorAll<HTMLButtonElement>('.segment')];
    const compteur = carrousel.querySelector('.compteur-actuel');
    const annonce = carrousel.querySelector('.annonce');
    const zone = carrousel.querySelector<HTMLElement>('.diapos');
    let actuelle = 0;

    const afficher = (cible: number, annoncer = true) => {
      const n = diapos.length;
      const suivante = ((cible % n) + n) % n;
      if (suivante === actuelle) return;
      carrousel.style.setProperty('--sens', cible > actuelle ? '1' : '-1');
      actuelle = suivante;

      diapos.forEach((d, i) => {
        const active = i === actuelle;
        d.classList.toggle('active', active);
        d.inert = !active;
      });
      segments.forEach((s, i) => {
        s.classList.toggle('passe', i < actuelle);
        if (i === actuelle) s.setAttribute('aria-current', 'true');
        else s.removeAttribute('aria-current');
      });
      if (compteur) compteur.textContent = String(actuelle + 1).padStart(2, '0');
      if (annonce && annoncer) {
        annonce.textContent = (carrousel.dataset.annonce ?? '{i} / {n} : {titre}')
          .replace('{i}', String(actuelle + 1))
          .replace('{n}', String(n))
          .replace('{titre}', diapos[actuelle].querySelector('.diapo-titre')?.textContent?.trim() ?? '');
      }
    };

    diapos.forEach((d, i) => (d.inert = i !== 0));

    carrousel.querySelector('.precedent')?.addEventListener('click', () => afficher(actuelle - 1));
    carrousel.querySelector('.suivant')?.addEventListener('click', () => afficher(actuelle + 1));
    segments.forEach((s) => s.addEventListener('click', () => afficher(Number(s.dataset.cible))));

    // Flèches du clavier quand le carrousel occupe l'écran
    let visible = false;
    new IntersectionObserver(([e]) => (visible = e.intersectionRatio > 0.55), {
      threshold: [0, 0.55, 1],
    }).observe(carrousel);

    document.addEventListener('keydown', (e) => {
      if (!visible || carrousel.classList.contains('recouverte') || e.altKey || e.ctrlKey || e.metaKey) return;
      const cible = e.target as HTMLElement;
      if (cible.closest('input, textarea, select, [contenteditable]')) return;
      if (e.key === 'ArrowRight') afficher(actuelle + 1);
      else if (e.key === 'ArrowLeft') afficher(actuelle - 1);
      else return;
      e.preventDefault();
    });

    // Glisser du doigt (ou à la souris) pour changer de diapositive
    let depart: { x: number; y: number } | null = null;
    zone?.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && (e.target as HTMLElement).closest('a, button')) return;
      depart = { x: e.clientX, y: e.clientY };
    });
    zone?.addEventListener('pointerup', (e) => {
      if (!depart) return;
      const dx = e.clientX - depart.x;
      const dy = e.clientY - depart.y;
      depart = null;
      if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) afficher(actuelle + (dx < 0 ? 1 : -1));
    });
    zone?.addEventListener('pointercancel', () => (depart = null));
  }
</script>

<style>
  .carrousel {
    --sens: 1;
    justify-content: space-between;
    gap: clamp(1rem, 3vh, 2.25rem);
    padding-bottom: clamp(1.75rem, 4vh, 3rem);
  }

  .carrousel .titre-section {
    font-size: clamp(2.5rem, min(6vw, 8vh), 4rem);
  }

  /* En-tête : titre à gauche, compteur à droite */
  .carrousel-entete {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem 2rem;
  }

  .compteur {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--f-titre);
    font-variant-numeric: tabular-nums;
    color: var(--gris-or);
  }

  .compteur-actuel {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1;
    color: var(--or-clair);
    font-style: italic;
  }

  .compteur-trait {
    width: 2.5rem;
    height: 1px;
    background: var(--or);
  }

  .compteur-total {
    font-size: 1.3rem;
  }

  /* Diapositives : toutes dans la même cellule de grille, la hauteur suit la plus grande */
  .diapos {
    position: relative;
    display: grid;
    width: 100%;
    max-width: var(--largeur);
    margin: 0 auto;
    isolation: isolate;
    touch-action: pan-y;
  }

  .diapo {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: center;
    gap: 2rem clamp(2rem, 6vw, 6rem);
  }

  :global(.js) .diapo {
    grid-area: 1 / 1;
    visibility: hidden;
    transition: visibility 0s linear 800ms;
  }

  :global(.js) .diapo.active {
    visibility: visible;
    transition-delay: 0s;
  }

  /* Sans JS : diapositives empilées et séparées */
  :global(html:not(.js)) .diapo + .diapo {
    margin-top: 4rem;
    padding-top: 4rem;
    border-top: 1px solid var(--filet);
  }

  :global(html:not(.js)) .carrousel-pied,
  :global(html:not(.js)) .compteur {
    display: none;
  }

  /* Grande année en filigrane, dorée au trait */
  .filigrane {
    position: absolute;
    right: -2%;
    top: 50%;
    z-index: -1;
    font-family: var(--f-titre);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(8rem, 26vw, 24rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px rgba(201, 169, 110, 0.12);
    translate: 0 -50%;
    pointer-events: none;
    user-select: none;
  }

  .diapo-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--or);
  }

  .point {
    width: 4px;
    height: 4px;
    background: var(--or);
    transform: rotate(45deg);
  }

  .badge {
    padding: 0.05rem 0.5rem;
    border: 1px solid rgba(224, 122, 95, 0.6);
    color: var(--braise-clair);
    letter-spacing: 0.16em;
  }

  .diapo-titre {
    font-family: var(--f-affiche);
    font-weight: 400;
    margin-top: 1rem;
    font-size: clamp(2.4rem, min(6vw, 8.5vh), 5.75rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.01em;
  }

  .diapo-titre a {
    color: var(--ivoire);
    text-decoration: none;
  }

  .diapo-titre a:hover {
    color: var(--or-clair);
  }

  .diapo-sous-titre {
    margin-top: 1rem;
    font-family: var(--f-titre);
    font-style: italic;
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    line-height: 1.3;
    color: var(--or-clair);
  }

  .diapo-resume {
    margin-top: 1.25rem;
    max-width: 38rem;
    font-size: 1.1rem;
    color: var(--texte-doux);
  }

  .diapo-sources {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0.85rem 0 0;
    max-width: 38rem;
    border-top: 1px solid var(--filet-pale);
    font-size: 0.9rem;
    color: var(--gris-or);
  }

  .diapo-sources li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.6rem;
  }

  .cote {
    color: var(--or-clair);
    font-variant-numeric: tabular-nums;
  }

  .diapo-texte .bouton {
    margin-top: 1.75rem;
  }

  /* Médaillon ovale : numéro, période, siècle */
  .diapo-medaillon {
    justify-self: center;
    width: min(100%, 21rem, 42vh);
  }

  .ovale {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    aspect-ratio: 3 / 4;
    border-radius: 50%;
    border: 1px solid var(--or);
    background:
      radial-gradient(60% 45% at 50% 40%, rgba(236, 217, 168, 0.14), transparent 70%),
      radial-gradient(100% 100% at 50% 100%, #2a1f15, #120e0a);
    box-shadow:
      0 0 0 0.6rem var(--carte),
      0 0 0 calc(0.6rem + 1px) var(--filet),
      0 40px 80px -30px rgba(0, 0, 0, 0.9);
  }

  .ovale::before {
    content: '';
    position: absolute;
    inset: 0.7rem;
    border-radius: 50%;
    border: 1px solid var(--filet-pale);
  }

  .ovale-numero {
    font-family: var(--f-script);
    font-size: clamp(4.5rem, 9vw, 7rem);
    line-height: 1;
    color: var(--or-clair);
    text-shadow: 0 0 40px rgba(236, 217, 168, 0.25);
  }

  .ovale-periode {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--f-titre);
    font-size: 1.5rem;
    color: var(--ivoire);
    font-variant-numeric: tabular-nums;
  }

  .losange {
    width: 5px;
    height: 5px;
    background: var(--or);
    transform: rotate(45deg);
  }

  .ovale-siecle {
    font-size: 0.7rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gris-or);
  }

  .ovale-siecle sup {
    font-size: 0.75em;
    letter-spacing: 0;
    text-transform: lowercase;
  }

  .en-cours .ovale {
    border-color: var(--braise);
  }

  /* Gravure en fond de diapositive : sépia, très atténuée, fondue vers la gauche */
  .diapo-fond {
    position: absolute;
    inset: -10% -6% -10% 30%;
    z-index: -2;
    background-size: cover;
    background-position: center;
    filter: sepia(1) saturate(0.6) brightness(0.55) contrast(1.1) blur(1px);
    opacity: 0.22;
    -webkit-mask-image: radial-gradient(70% 70% at 70% 50%, #000 30%, transparent 75%);
    mask-image: radial-gradient(70% 70% at 70% 50%, #000 30%, transparent 75%);
    pointer-events: none;
  }

  /* Ovale illustré : la gravure encadrée comme un portrait ancien */
  .ovale-gravure {
    padding: 0;
    gap: 0;
  }

  .ovale-gravure img {
    position: absolute;
    inset: 0.7rem;
    width: calc(100% - 1.4rem);
    height: calc(100% - 1.4rem);
    border-radius: 50%;
    object-fit: cover;
    filter: sepia(0.85) saturate(0.75) contrast(1.08) brightness(0.88);
  }

  /* Image par défaut (papier clair) : assombrie pour s'accorder aux vraies gravures */
  .ovale-gravure img[src$='defaut.svg'] {
    filter: sepia(0.6) saturate(0.8) brightness(0.68) contrast(1.15);
  }

  /* Vernis doré et vignettage par-dessus la gravure */
  .ovale-gravure::after {
    content: '';
    position: absolute;
    inset: 0.7rem;
    border-radius: 50%;
    background:
      radial-gradient(70% 70% at 50% 40%, transparent 45%, rgba(13, 11, 8, 0.75) 100%),
      linear-gradient(160deg, rgba(236, 217, 168, 0.18), rgba(120, 80, 30, 0.25));
    mix-blend-mode: multiply;
  }

  .ovale-pastille {
    position: absolute;
    left: 50%;
    bottom: -0.2rem;
    z-index: 2;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    border: 1px solid var(--or);
    background: var(--carte);
    box-shadow: 0 0 0 4px var(--carte);
    font-family: var(--f-script);
    font-size: 1.7rem;
    color: var(--or-clair);
  }

  .credit {
    margin-top: 1.4rem;
    max-width: 18rem;
    margin-inline: auto;
    text-align: center;
    font-size: 0.68rem;
    line-height: 1.4;
    letter-spacing: 0.04em;
    font-style: italic;
    color: rgba(169, 156, 131, 0.75);
  }

  .en-cours .ovale-numero {
    color: var(--braise-clair);
  }

  /* Pied : barre de progression cliquable + flèches */
  .carrousel-pied {
    display: flex;
    align-items: flex-end;
    gap: 1.5rem 2.5rem;
  }

  .progression {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(var(--total), minmax(0, 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .segment {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    width: 100%;
    padding: 0.5rem 0 0;
    background: none;
    border: 0;
    color: var(--gris-or);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .segment-num {
    font-family: var(--f-titre);
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .segment-titre {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .segment-barre {
    grid-column: 1 / -1;
    position: relative;
    height: 1px;
    margin-top: 0.5rem;
    background: rgba(201, 169, 110, 0.25);
  }

  .segment-barre span {
    position: absolute;
    inset: 0;
    background: var(--or-clair);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 700ms cubic-bezier(0.65, 0, 0.25, 1);
  }

  .segment.passe .segment-barre span {
    transform: scaleX(1);
    opacity: 0.45;
  }

  .segment[aria-current='true'] {
    color: var(--or-clair);
  }

  .segment[aria-current='true'] .segment-titre {
    opacity: 1;
  }

  .segment[aria-current='true'] .segment-barre span {
    transform: scaleX(1);
  }

  .segment:hover {
    color: var(--ivoire);
  }

  .fleches {
    display: flex;
    gap: 0.75rem;
  }

  .fleche-btn {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgba(201, 169, 110, 0.55);
    background: transparent;
    color: var(--or-clair);
    cursor: pointer;
    transition:
      background-color 250ms ease,
      color 250ms ease,
      transform 250ms ease;
  }

  .fleche-btn svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }

  .fleche-btn:hover {
    background: var(--or-clair);
    color: var(--fond);
  }

  /* Transitions entre diapositives */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .diapo .anime {
      opacity: 0;
      translate: calc(var(--sens) * 2.5rem) 0;
      transition:
        opacity 450ms ease,
