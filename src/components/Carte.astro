---
// Carte ancienne des lieux du parcours et des travaux, gravée à l'encre sur un parchemin :
// rivières, anciennes provinces, villes repères, forêts, rose des vents, cartouche et échelle.
// Les lieux viennent des champs `commune` (parcours dans profil.ts, travaux dans leurs fichiers)
// et leurs coordonnées de `communes` (profil.ts). Tout est calculé ici, à la construction du site.
// Affichée dans l'onglet « Cartographie » du chapitre « Parcours » (Parcours.astro).
import { communes } from '../data/profil';
import type { Travail } from '../data/travaux';
import { lien, localiser, t, type Langue } from '../i18n';

interface Etape {
  dates: string;
  datesSource?: string;
  titre: string;
  lieu: string;
  commune?: string;
}

interface Props {
  lang: Langue;
  parcours: Etape[];
  travaux: Travail[];
}

const { lang, parcours, travaux } = Astro.props;
const tx = t(lang).carte;

// ——— Projection : équirectangulaire, corrigée à la latitude moyenne ———
const lonMin = -0.35;
const lonMax = 1.75;
const latMin = 47.1;
const latMax = 48.45;
const cosLat = Math.cos((((latMin + latMax) / 2) * Math.PI) / 180);
const L = 1000;
const k = L / ((lonMax - lonMin) * cosLat);
const H = Math.round((latMax - latMin) * k);
const xy = (lon: number, lat: number): [number, number] => [(lon - lonMin) * cosLat * k, (latMax - lat) * k];
const f = (n: number) => n.toFixed(1);

// Courbe lisse passant par tous les points (Catmull-Rom → Bézier)
const courbe = (points: [number, number][]) => {
  const p = points.map(([lon, lat]) => xy(lon, lat));
  let d = `M${f(p[0][0])} ${f(p[0][1])}`;
  for (let i = 0; i < p.length - 1; i++) {
    const p0 = p[i - 1] ?? p[i];
    const p1 = p[i];
    const p2 = p[i + 1];
    const p3 = p[i + 2] ?? p2;
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += `C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p2[0])} ${f(p2[1])}`;
  }
  return d;
};

// ——— Rivières (tracé simplifié, de l'amont vers l'aval sauf mention) ———
const rivieres = [
  {
    id: 'loire',
    nom: 'La Loire',
    taille: 1.9,
    etiquette: 58,
    points: [[1.75, 47.82], [1.6, 47.73], [1.5, 47.67], [1.33, 47.59], [1.2, 47.53], [1.1, 47.47], [0.98, 47.41], [0.83, 47.41], [0.69, 47.4], [0.55, 47.37], [0.41, 47.33], [0.33, 47.28], [0.2, 47.25], [0.06, 47.215], [-0.08, 47.26], [-0.22, 47.35], [-0.35, 47.37]],
  },
  {
    id: 'cher',
    nom: 'Le Cher',
    taille: 1.3,
    etiquette: 30,
    points: [[1.75, 47.22], [1.5, 47.25], [1.37, 47.27], [1.31, 47.32], [1.18, 47.34], [1.08, 47.33], [0.99, 47.33], [0.85, 47.34], [0.7, 47.375], [0.6, 47.36], [0.47, 47.34]],
  },
  {
    id: 'loir',
    nom: 'Le Loir',
    taille: 1.3,
    etiquette: 42,
    points: [[1.25, 48.33], [1.38, 48.18], [1.33, 48.07], [1.23, 47.99], [1.07, 47.79], [0.86, 47.75], [0.58, 47.73], [0.42, 47.69], [0.16, 47.65], [-0.08, 47.7], [-0.24, 47.67], [-0.35, 47.62]],
  },
  {
    id: 'sarthe',
    nom: 'La Sarthe',
    taille: 1.4,
    etiquette: 62,
    points: [[0.09, 48.45], [0.13, 48.23], [0.19, 48.12], [0.19, 48.07], [0.19, 48.0], [0.15, 47.92], [0.0, 47.88], [-0.08, 47.82], [-0.2, 47.83], [-0.35, 47.8]],
  },
  {
    id: 'huisne',
    nom: 'L’Huisne',
    taille: 1.1,
    etiquette: 40,
    points: [[0.95, 48.4], [0.82, 48.32], [0.65, 48.19], [0.49, 48.06], [0.41, 48.05], [0.2, 47.99]],
  },
].map((r) => ({ ...r, d: courbe(r.points as [number, number][]) }));

// ——— Repères du décor ———
const provinces = [
  { nom: 'MAINE', lon: 0.38, lat: 48.33 },
  { nom: 'ANJOU', lon: -0.28, lat: 47.5, debut: true },
  { nom: 'TOURAINE', lon: 0.38, lat: 47.16 },
  { nom: 'VENDÔMOIS', lon: 0.95, lat: 47.98 },
  { nom: 'BLÉSOIS', lon: 1.52, lat: 47.44 },
].map((p) => ({ ...p, pos: xy(p.lon, p.lat) }));

const villes = [
  { nom: 'Saumur', lon: -0.077, lat: 47.26 },
  { nom: 'La Flèche', lon: -0.076, lat: 47.6997 },
  { nom: 'Château-du-Loir', lon: 0.4197, lat: 47.6947 },
  { nom: 'Vendôme', lon: 1.0656, lat: 47.7928 },
  { nom: 'Blois', lon: 1.3359, lat: 47.5861 },
  { nom: 'Amboise', lon: 0.9822, lat: 47.4125 },
  { nom: 'Nogent-le-Rotrou', lon: 0.8217, lat: 48.3217 },
  { nom: 'Saint-Calais', lon: 0.745, lat: 47.92 },
].map((v) => ({ ...v, pos: xy(v.lon, v.lat) }));

const forets = [
  { nom: 'Forêt de Bercé', lon: 0.39, lat: 47.81 },
  { nom: 'Forêt de Vibraye', lon: 0.73, lat: 48.05 },
].map((fo) => ({ ...fo, pos: xy(fo.lon, fo.lat) }));
const arbres = [[-16, 0], [0, -6], [16, 1], [-8, 12], [9, 13], [24, 12], [-24, 12]];

// ——— Lieux du parcours et des travaux ———
const ident = (nom: string) =>
  nom
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-');

// Étiquette au-dessus du point quand un autre lieu est juste à côté (Le Mans / Neuville) :
// à gauche, elle sortirait du cadre
const auDessus = new Set(['Neuville-sur-Sarthe']);

const lieux = Object.entries(communes)
  .map(([nom, c]) => {
    const etapes = parcours.filter((p) => p.commune === nom);
    const projets = travaux.filter((tr) => tr.data.commune === nom);
    const [x, y] = xy(c.lon, c.lat);
    return {
      id: ident(nom),
      nom,
      detail: localiser(c, lang).detail,
      x,
      y,
      dessus: auDessus.has(nom),
      etapes,
      projets,
    };
  })
  .filter((l) => l.etapes.length + l.projets.length > 0);

// Fil du parcours : les communes dans l'ordre chronologique (le parcours est rangé du plus récent au plus ancien)
const suite = [...parcours]
  .reverse()
  .map((p) => p.commune)
  .filter((c): c is string => !!c && !!communes[c])
  .filter((c, i, tout) => c !== tout[i - 1]);
const fil = (() => {
  let d = '';
  suite.forEach((c, i) => {
    const [x, y] = xy(communes[c].lon, communes[c].lat);
    if (i === 0) {
      d = `M${f(x)} ${f(y)}`;
      return;
    }
    const [x0, y0] = xy(communes[suite[i - 1]].lon, communes[suite[i - 1]].lat);
    // Arc léger : point de contrôle décalé perpendiculairement au segment
    const mx = (x0 + x) / 2;
    const my = (y0 + y) / 2;
    const dx = x - x0;
    const dy = y - y0;
    const bombe = i % 2 ? 0.22 : -0.22;
    d += `Q${f(mx - dy * bombe)} ${f(my + dx * bombe)} ${f(x)} ${f(y)}`;
  });
  return d;
})();

// Coordonnées du centre de la carte (mises à jour pendant le zoom)
const dms = (deg: number) => {
  const a = Math.abs(deg);
  const m = Math.round((a % 1) * 60);
  return `${Math.floor(a) + (m === 60 ? 1 : 0)}°${String(m % 60).padStart(2, '0')}′`;
};
const lonCentre = (lonMin + lonMax) / 2;
const coordonneesCentre = `${dms((latMin + latMax) / 2)} N · ${dms(lonCentre)} ${lonCentre < 0 ? tx.ouest : 'E'}`;

// Échelle : 20 km
const echelle = (20 / 111.2) * k;

// Rose des vents
const rose = { x: 915, y: 105, r: 52 };
const branches = Array.from({ length: 8 }, (_, i) => {
  const a = (i * Math.PI) / 4 - Math.PI / 2;
  const long = i % 2 ? rose.r * 0.55 : rose.r;
  const g = a - Math.PI / 2;
  const d = a + Math.PI / 2;
  const l = i % 2 ? 5 : 8;
  const pointe = [rose.x + Math.cos(a) * long, rose.y + Math.sin(a) * long];
  const p1 = [rose.x + Math.cos(g) * l, rose.y + Math.sin(g) * l];
  const p2 = [rose.x + Math.cos(d) * l, rose.y + Math.sin(d) * l];
  return {
    claire: `M${f(rose.x)} ${f(rose.y)}L${f(p1[0])} ${f(p1[1])}L${f(pointe[0])} ${f(pointe[1])}Z`,
    sombre: `M${f(rose.x)} ${f(rose.y)}L${f(p2[0])} ${f(p2[1])}L${f(pointe[0])} ${f(pointe[1])}Z`,
  };
});

// Bordure graduée (alternance de segments pleins et vides, comme sur les cartes anciennes)
const pas = 50;
const graduations: string[] = [];
for (let x = 12; x < L - 12; x += pas * 2) graduations.push(`M${x} 12h${Math.min(pas, L - 12 - x)}M${x} ${H - 12}h${Math.min(pas, L - 12 - x)}`);
for (let y = 12; y < H - 12; y += pas * 2) graduations.push(`M12 ${y}v${Math.min(pas, H - 12 - y)}M${L - 12} ${y}v${Math.min(pas, H - 12 - y)}`);
---

<div class="atlas" data-reveal>
  <figure class="carte-papier">
    <div class="carte-cadre" style={`aspect-ratio: ${L} / ${H}`}>
      <svg
        class="plan"
        viewBox={`0 0 ${L} ${H}`}
        role="group"
        aria-labelledby="legende-carte"
        data-l={L}
        data-h={H}
        data-k={k}
        data-cos={cosLat}
        data-lon-min={lonMin}
        data-lat-max={latMax}
        data-locale={t(lang).locale}
        data-ouest={tx.ouest}
      >
        <defs>
          <clipPath id="carte-interieur">
            <rect x="18" y="18" width={L - 36} height={H - 36}></rect>
          </clipPath>
        </defs>

        <!-- Le « monde » : tout ce qui se zoome. Le cadre, la rose et le cartouche restent fixes. -->
        <g clip-path="url(#carte-interieur)">
          <g class="monde">
            <!-- Provinces -->
            {
              provinces.map((p) => (
                <g transform={`translate(${f(p.pos[0])} ${f(p.pos[1])})`}>
                  <g class="contre">
                    <text class:list={['province', { debut: p.debut }]}>{p.nom}</text>
                  </g>
                </g>
              ))
            }

            <!-- Forêts -->
            {
              forets.map((fo) => (
                <g class="foret" transform={`translate(${f(fo.pos[0])} ${f(fo.pos[1])})`}>
                  {arbres.map(([dx, dy]) => (
                    <path d={`M${dx} ${dy - 9}l-5 9h10z M${dx} ${dy}v3`} />
                  ))}
                  <text y="32" class="foret-nom">
                    {fo.nom}
                  </text>
                </g>
              ))
            }

            <!-- Rivières : un liseré pâle sous un trait d'encre, et leur nom le long du cours -->
            {
              rivieres.map((r) => (
                <g class="riviere">
                  <path id={`riv-${r.id}`} d={r.d} class="eau" style={`--w: ${r.taille * 4}`} />
                  <path d={r.d} class="cours" pathLength="1" style={`--w: ${r.taille}`} />
                  <text class="riviere-nom" dy="-7">
                    <textPath href={`#riv-${r.id}`} startOffset={`${r.etiquette}%`} text-anchor="middle">
                      {r.nom}
                    </textPath>
                  </text>
                </g>
              ))
            }

            <!-- Villes repères -->
            {
              villes.map((v) => (
                <g class="ville" transform={`translate(${f(v.pos[0])} ${f(v.pos[1])})`}>
                  <g class="contre">
                    <circle r="3.2" />
                    <text x="7" y="4">
                      {v.nom}
                    </text>
                  </g>
                </g>
              ))
            }

            <!-- Fil du parcours -->
            {suite.length > 1 && <path d={fil} class="fil" />}

            <!-- Lieux du parcours et des travaux : un clic zoome sur le lieu -->
            {
              lieux.map((l, i) => (
                <g
                  class="lieu"
                  data-lieu={l.id}
                  data-x={f(l.x)}
                  data-y={f(l.y)}
                  transform={`translate(${f(l.x)} ${f(l.y)})`}
                  role="button"
                  tabindex="0"
                  aria-label={l.nom}
                  aria-controls={`fiche-${l.id}`}
                  aria-pressed="false"
                >
                  <g class="contre">
                    <g class="lieu-pose" style={`--i: ${i}`}>
                      <circle r="15" class="lieu-onde" />
                      <circle r="25" class="lieu-anneau" pathLength="1" />
                      <circle r="15" class="lieu-halo" />
                      <circle r="7.5" class="lieu-cire" />
                      <circle r="2.6" class="lieu-coeur" />
                      <text x={l.dessus ? 0 : 14} y={l.dessus ? -15 : 6} class:list={['lieu-nom', { dessus: l.dessus }]}>
                        {l.nom}
                      </text>
                    </g>
                  </g>
                </g>
              ))
            }
          </g>
        </g>

        <!-- Cadre et bordure graduée -->
        <rect x="6" y="6" width={L - 12} height={H - 12} class="cadre-ext"></rect>
        <rect x="18" y="18" width={L - 36} height={H - 36} class="cadre-int"></rect>
        <path d={graduations.join('')} class="graduation"></path>

        <!-- Rose des vents : elle oscille quand la carte se déplace -->
        <g class="rose" style={`transform-origin: ${rose.x}px ${rose.y}px`}>
          <circle cx={rose.x} cy={rose.y} r={rose.r * 0.72} class="rose-cercle"></circle>
          <circle cx={rose.x} cy={rose.y} r={rose.r * 0.62} class="rose-cercle"></circle>
          {
            branches.map((b) => (
              <>
                <path d={b.claire} class="rose-claire" />
                <path d={b.sombre} class="rose-sombre" />
              </>
            ))
          }
          <text x={rose.x} y={rose.y - rose.r - 8} class="rose-nord">N</text>
        </g>

        <!-- Cartouche, avec l'échelle (son libellé suit le zoom) -->
        <g class="cartouche">
          <rect x="34" y="34" width="168" height="150" class="cartouche-fond"></rect>
          <rect x="40" y="40" width="156" height="138" class="cartouche-filet"></rect>
          <text x="118" y="76" class="cartouche-titre">{tx.cartouche[0]}</text>
          <text x="118" y="102" class="cartouche-ligne">{tx.cartouche[1]}</text>
          <text x="118" y="122" class="cartouche-ligne">{tx.cartouche[2]}</text>
          <g transform={`translate(${f(118 - echelle / 2)} 150)`}>
            <path d={`M0 0h${f(echelle)}M0 -4v8M${f(echelle / 2)} -3v6M${f(echelle)} -4v8`} class="echelle"></path>
            <rect x="0" y="-2" width={f(echelle / 2)} height="4" class="echelle-plein"></rect>
            <text x={f(echelle / 2)} y="20" class="echelle-texte">{tx.echelle}</text>
          </g>
        </g>

        <!-- Coordonnées du centre de la vue -->
        <text x={L - 36} y={H - 38} class="coordonnees">{coordonneesCentre}</text>
      </svg>

      <button type="button" class="vue-ensemble" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path>
        </svg>
        {tx.ensemble}
      </button>
    </div>
    <figcaption id="legende-carte" class="carte-legende">
      {tx.legende}. <span class="fil-legende"><span aria-hidden="true" class="fil-trait"></span>{tx.itineraire}</span> · {tx.note}.
    </figcaption>
  </figure>

  <div class="fiches-lieux" aria-live="polite">
    <p class="invitation-lieu">
      <span class="invitation-losange" aria-hidden="true"></span>
      {tx.invitation}
    </p>
    {
      lieux.map((l) => (
        <article class="fiche-lieu" id={`fiche-${l.id}`} data-lieu={l.id} hidden>
          <h3>{l.nom}</h3>
          {l.detail && <p class="lieu-detail">{l.detail}</p>}
          {l.etapes.length > 0 && (
            <>
              <p class="lieu-rubrique">{tx.parcours}</p>
              <ul>
                {l.etapes.map((e) => (
                  <li>
                    <span class="lieu-dates">{e.dates}</span>
                    <span class="lieu-titre">{e.titre}</span>
                    <span class="lieu-lieu">{e.lieu}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
          {l.projets.length > 0 && (
            <>
              <p class="lieu-rubrique">{tx.travaux}</p>
              <ul>
                {l.projets.map((p) => (
                  <li>
                    <a href={lien(lang, `/travaux/${p.id}/`)}>
                      {p.data.titre} <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </article>
      ))
    }
  </div>
</div>

<script>
  // ——— Carte animée : un clic sur un lieu fait voler la vue jusqu'à lui ———
  // La vue (centre x, y et zoom z) est appliquée au groupe « monde ». Les étiquettes et les
  // pastilles sont contre-zoomées (--inv) pour garder leur taille ; l'échelle et les
  // coordonnées du cartouche suivent le mouvement.
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ZOOM = 3.2;

  document.querySelectorAll<HTMLElement>('.atlas').forEach((atlas) => {
    const plan = atlas.querySelector<SVGSVGElement>('svg.plan');
    const monde = plan?.querySelector<SVGGElement>('.monde');
    if (!plan || !monde) return;

    const d = plan.dataset;
    const L = Number(d.l);
    const H = Number(d.h);
    const k = Number(d.k);
    const cos = Number(d.cos);
    const lonMin = Number(d.lonMin);
    const latMax = Number(d.latMax);
    const nombre = new Intl.NumberFormat(d.locale, { maximumFractionDigits: 1 });

    const lieux = [...plan.querySelectorAll<SVGGElement>('.lieu')];
    const fiches = [...atlas.querySelectorAll<HTMLElement>('.fiche-lieu')];
    const invitation = atlas.querySelector<HTMLElement>('.invitation-lieu');
    const ensemble = atlas.querySelector<HTMLButtonElement>('.vue-ensemble');
    const rose = plan.querySelector<SVGGElement>('.rose');
    const echelle = plan.querySelector<SVGTextElement>('.echelle-texte');
    const coordonnees = plan.querySelector<SVGTextElement>('.coordonnees');

    type Vue = { x: number; y: number; z: number };
    let vue: Vue = { x: L / 2, y: H / 2, z: 1 };
    let image = 0;
    let actif = '';

    // La vue ne sort jamais de la carte
    const borner = (v: Vue): Vue => {
      const z = Math.max(1, v.z);
      const dl = L / (2 * z);
      const dh = H / (2 * z);
      return { x: Math.min(L - dl, Math.max(dl, v.x)), y: Math.min(H - dh, Math.max(dh, v.y)), z };
    };

    const dms = (deg: number) => {
      const a = Math.abs(deg);
      const m = Math.round((a % 1) * 60);
      return `${Math.floor(a) + (m === 60 ? 1 : 0)}°${String(m % 60).padStart(2, '0')}′`;
    };

    const appliquer = (v: Vue) => {
      monde.setAttribute(
        'transform',
        `translate(${(L / 2 - v.x * v.z).toFixed(2)} ${(H / 2 - v.y * v.z).toFixed(2)}) scale(${v.z.toFixed(4)})`,
      );
      plan.style.setProperty('--inv', String(1 / v.z));
      plan.style.setProperty('--inv-doux', String(v.z ** -0.6));
      if (echelle) echelle.textContent = `${nombre.format(20 / v.z)} km`;
      if (coordonnees) {
        const lon = v.x / (cos * k) + lonMin;
        const lat = latMax - v.y / k;
        coordonnees.textContent = `${dms(lat)} N · ${dms(lon)} ${lon < 0 ? d.ouest : 'E'}`;
      }
    };

    // Rejoue une animation CSS liée à une classe
    const relancer = (el: Element | null | undefined, classe: string) => {
      if (!el) return;
      el.classList.remove(classe);
      void el.getBoundingClientRect();
      el.classList.add(classe);
    };

    const voler = (cible: Vue, arrivee?: () => void) => {
      cible = borner(cible);
      cancelAnimationFrame(image);
      if (reduit) {
        vue = cible;
        appliquer(vue);
        arrivee?.();
        return;
      }
      const depart = { ...vue };
      // Plus le trajet est long, plus la vue prend de la hauteur en chemin
      const distance = Math.hypot(cible.x - depart.x, cible.y - depart.y) * Math.min(depart.z, cible.z);
      const recul = Math.min(0.4, distance / L);
      const duree = 1000 + Math.min(800, distance * 1.4);
      const debut = performance.now();
      relancer(rose, 'oscille');
      atlas.classList.add('en-vol');

      const pas = (maintenant: number) => {
        const p = Math.min(1, (maintenant - debut) / duree);
        const e = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
        const z = depart.z * Math.pow(cible.z / depart.z, e) * (1 - recul * Math.sin(Math.PI * e));
        vue = borner({ x: depart.x + (cible.x - depart.x) * e, y: depart.y + (cible.y - depart.y) * e, z });
        appliquer(vue);
        if (p < 1) {
          image = requestAnimationFrame(pas);
          return;
        }
        vue = cible;
        appliquer(vue);
        atlas.classList.remove('en-vol');
        arrivee?.();
      };
      image = requestAnimationFrame(pas);
    };

    const choisir = (id: string) => {
      if (id === actif) return;
      actif = id;
      lieux.forEach((l) => {
        const oui = l.dataset.lieu === id;
        l.setAttribute('aria-pressed', String(oui));
        l.classList.toggle('actif', oui);
        l.classList.remove('arrive');
      });
      fiches.forEach((f) => (f.hidden = f.dataset.lieu !== id));
      if (invitation) invitation.hidden = !!id;
      if (ensemble) ensemble.hidden = !id;
      atlas.classList.toggle('zoome', !!id);

      const lieu = lieux.find((l) => l.dataset.lieu === id);
      if (lieu) voler({ x: Number(lieu.dataset.x), y: Number(lieu.dataset.y), z: ZOOM }, () => relancer(lieu, 'arrive'));
      else voler({ x: L / 2, y: H / 2, z: 1 });
    };

    lieux.forEach((l) => {
      const id = l.dataset.lieu ?? '';
      l.addEventListener('click', () => choisir(id));
      l.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        choisir(id);
      });
    });

    // Retour à la vue d'ensemble : bouton ou touche Échap
    ensemble?.addEventListener('click', () => {
      const precedent = lieux.find((l) => l.dataset.lieu === actif);
      choisir('');
      precedent?.focus({ preventScroll: true });
    });

    atlas.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && actif) choisir('');
    });

    // Étiquettes lisibles quelle que soit la taille d'affichage de la carte
    const ajuster = () => {
      const largeur = plan.getBoundingClientRect().width;
      if (largeur > 0) plan.style.setProperty('--etiquettes', String(Math.min(2, Math.max(1, 720 / largeur))));
    };
    if ('ResizeObserver' in window) new ResizeObserver(ajuster).observe(plan);
    ajuster();

    appliquer(vue);
  });
</script>

