---
import '../styles/global.css';
import { profil } from '../data/profil';
import { langueDe, lien, localiser, t, traduireChemin } from '../i18n';
import Ambiance from '../components/Ambiance.astro';
import Chargeur from '../components/Chargeur.astro';
import Bougie from '../components/Bougie.astro';
import Loupe from '../components/Loupe.astro';

interface Props {
  titre?: string;
  description?: string;
}

const lang = langueDe(Astro.url);
const tx = t(lang);
const p = localiser(profil, lang);
const { titre, description = p.presentation } = Astro.props;
const titrePage = titre ? `${titre}, ${profil.nom}` : `${profil.nom}`;
const accueil = Astro.url.pathname === lien(lang, '/');
const autre = lang === 'fr' ? 'en' : 'fr';
const cheminFr = traduireChemin(Astro.url, 'fr');
const cheminEn = traduireChemin(Astro.url, 'en');
const absolu = (chemin: string) => (Astro.site ? new URL(chemin, Astro.site).href : chemin);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Aperçu lors d'un partage (LinkedIn, messageries) : renseigner `site` dans astro.config.mjs
         pour que l'adresse de l'image soit complète une fois le site en ligne -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={tx.ogLocale} />
    <meta property="og:site_name" content={profil.nom} />
    <meta property="og:title" content={titrePage} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absolu('/og.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={tx.portfolioDe(profil.nom)} />
    {Astro.site && <meta property="og:url" content={absolu(Astro.url.pathname)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0d0b08" />
    <!-- Même page dans l'autre langue, pour les moteurs de recherche -->
    <link rel="alternate" hreflang="fr" href={absolu(cheminFr)} />
    <link rel="alternate" hreflang="en" href={absolu(cheminEn)} />
    <link rel="alternate" hreflang="x-default" href={absolu(cheminFr)} />
    <!-- Icône du site : monogramme CL (public/favicon.svg, .ico pour les anciens navigateurs) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Pinyon+Script&family=Libre+Caslon+Display&display=swap"
    />
    <title>{titrePage}</title>
    <script is:inline>
      (function () {
        var html = document.documentElement;
        html.classList.add('js');
        // Thème choisi lors d'une visite précédente (bougie soufflée = thème clair), appliqué avant l'affichage
        try {
          if (localStorage.getItem('theme') === 'clair') {
            html.dataset.theme = 'clair';
            document.querySelector('meta[name="theme-color"]').setAttribute('content', '#efe4cc');
          }
        } catch (e) {}
        // Chargeur : à l'arrivée sur le site et au rechargement, pas en naviguant entre les pages
        try {
          var nav = performance.getEntriesByType('navigation')[0];
          var type = nav ? nav.type : 'navigate';
          var interne = !!document.referrer && new URL(document.referrer).origin === location.origin;
          if (type === 'reload' || (type !== 'back_forward' && !interne)) html.classList.add('chargement');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Chargeur />
    <Ambiance />
    <a class="evitement" href="#contenu">{tx.evitement}</a>
    <header class="entete">
      {
        accueil ? (
          <span class="signature">
            <span class="ecrit">{profil.nom}</span>
          </span>
        ) : (
          <a class="signature" href={lien(lang, '/')}>
            <span class="ecrit">{profil.nom}</span>
          </a>
        )
      }
      <div class="entete-droite">
        <nav id="menu-principal" aria-label={tx.navPrincipale}>
          <a href={lien(lang, '/#parcours')}>{tx.nav.parcours}</a>
          <a href={lien(lang, '/#travaux')}>{tx.nav.travaux}</a>
          <a href={lien(lang, '/#competences')}>{tx.nav.competences}</a>
          <a href={lien(lang, '/#contact')}>{tx.nav.contact}</a>
        </nav>
        <span class="outils-entete">
          <a class="langue" href={autre === 'en' ? cheminEn : cheminFr} hreflang={autre} lang={autre} aria-label={tx.autreLangue.long}>
            {tx.autreLangue.court}
          </a>
          <Bougie lang={lang} />
          <!-- Écrans étroits : la navigation s'ouvre dans un panneau -->
          <button type="button" class="menu-bouton" aria-expanded="false" aria-controls="menu-principal">
            <span class="menu-traits" aria-hidden="true"><span></span><span></span></span>
            <span class="menu-libelle">{tx.menu}</span>
          </button>
        </span>
      </div>
    </header>
    <main id="contenu">
      <slot />
    </main>
    {
      !accueil && (
        <footer class="page pied">
          <span class="losange" aria-hidden="true" />
          <p>
            {profil.nom} · {new Date().getFullYear()}
          </p>
          <span class="losange" aria-hidden="true" />
        </footer>
      )
    }
    <Loupe />
    <script>
      // Menu des écrans étroits : s'ouvre et se ferme au bouton, se referme au choix d'un lien,
      // à la touche Échap ou au clic en dehors
      const entete = document.querySelector<HTMLElement>('.entete');
      const boutonMenu = entete?.querySelector<HTMLButtonElement>('.menu-bouton');
      const ouvrirMenu = (ouvert: boolean) => {
        if (!entete || !boutonMenu) return;
        entete.classList.toggle('menu-ouvert', ouvert);
        boutonMenu.setAttribute('aria-expanded', String(ouvert));
      };
      boutonMenu?.addEventListener('click', () => ouvrirMenu(!entete?.classList.contains('menu-ouvert')));
      entete?.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => ouvrirMenu(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && entete?.classList.contains('menu-ouvert')) {
          ouvrirMenu(false);
          boutonMenu?.focus();
        }
      });
      document.addEventListener('click', (e) => {
        if (entete?.classList.contains('menu-ouvert') && !entete.contains(e.target as Node)) ouvrirMenu(false);
      });
      window.matchMedia('(min-width: 68.001rem)').addEventListener('change', (m) => m.matches && ouvrirMenu(false));
    </script>
    <script>
      // Apparition au défilement : chaque élément [data-reveal] reçoit .revele en entrant dans l'écran,
      // et le perd quand il en sort complètement : ses animations se rejouent au retour.
      const elements = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (!('IntersectionObserver' in window)) {
        elements.forEach((el) => el.classList.add('revele'));
      } else {
        // Entrée : un peu avant le bas de l'écran
        const entree = new IntersectionObserver(
          (entrees) => {
            for (const e of entrees) if (e.isIntersecting) e.target.classList.add('revele');
          },
          { threshold: 0, rootMargin: '0px 0px -8% 0px' },
        );
        // Sortie : seulement quand plus aucun pixel n'est visible (évite les clignotements)
        const sortie = new IntersectionObserver(
          (entrees) => {
            for (const e of entrees) if (!e.isIntersecting) e.target.classList.remove('revele');
          },
          { threshold: 0 },
        );
        elements.forEach((el) => {
          entree.observe(el);
          sortie.observe(el);
        });
      }
    </script>
  </body>
</html>

<style>
  /* En-tête fixe, posé sur les écrans plein cadre */
  .entete {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 2rem;
    padding: clamp(1.4rem, 3.5vh, 2.1rem) calc(var(--gouttiere) + clamp(0.5rem, 1.2vw, 0.9rem) + 0.5rem);
    background: var(--entete-fond);
    pointer-events: none;
  }

  .entete > * {
    pointer-events: auto;
  }

  .signature {
    font-family: var(--f-script);
    font-size: 1.9rem;
    line-height: 1;
    color: var(--or-clair);
    text-decoration: none;
  }

  .entete-droite {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem clamp(1rem, 3vw, 2.25rem);
  }

  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
  }

  nav a,
  .langue {
    font-size: 0.75rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gris-or);
    text-decoration: none;
    padding: 0.35rem 0;
    background: linear-gradient(var(--or), var(--or)) bottom center / 0 1px no-repeat;
    transition:
      color 250ms ease,
      background-size 250ms ease;
  }

  nav a:hover,
  .langue:hover {
    color: var(--or-clair);
    background-size: 100% 1px;
  }

  .outils-entete {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-left: clamp(0.75rem, 2vw, 1.5rem);
    border-left: 1px solid var(--filet);
  }

  .langue {
    letter-spacing: 0.16em;
  }

  .menu-bouton {
    display: none;
  }

  /* Écrans étroits (tablettes, téléphones, petits portables) : une seule ligne
     (nom, langue, bougie, bouton Menu) ; la navigation s'ouvre dans un panneau sous l'en-tête */
  @media (max-width: 68rem) {
    .entete {
      flex-wrap: nowrap;
      gap: 1rem;
      padding-block: clamp(0.8rem, 2vh, 1.2rem);
    }

    .signature {
      font-size: clamp(1.45rem, 5.5vw, 1.8rem);
      white-space: nowrap;
    }

    .entete-droite {
      flex-wrap: nowrap;
    }

    .outils-entete {
      gap: clamp(0.6rem, 2.5vw, 0.9rem);
    }

    .menu-bouton {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      min-height: 2.75rem;
      padding: 0 0 0 0.25rem;
      border: 0;
      background: none;
      color: var(--or-clair);
      font: inherit;
      font-size: 0.72rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .menu-traits {
      position: relative;
      display: grid;
      gap: 5px;
      width: 1.35rem;
    }

    .menu-traits span {
      height: 1px;
      background: currentColor;
      transition:
        transform 300ms ease,
        width 300ms ease;
    }

    .menu-traits span:last-child {
      width: 70%;
      justify-self: end;
    }

    .menu-ouvert .menu-traits span:first-child {
      transform: translateY(3px) rotate(45deg);
    }

    .menu-ouvert .menu-traits span:last-child {
      width: 100%;
      transform: translateY(-3px) rotate(-45deg);
    }

    nav {
      position: absolute;
      top: calc(100% - 0.25rem);
      left: calc(var(--gouttiere) + 0.5rem);
      right: calc(var(--gouttiere) + 0.5rem);
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 1.5rem;
      border: 1px solid var(--filet);
      background: var(--carte);
      box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.85);
      opacity: 0;
      visibility: hidden;
      translate: 0 -0.5rem;
      transition:
        opacity 250ms ease,
        translate 250ms ease,
        visibility 0s 250ms;
    }

    .menu-ouvert nav {
      opacity: 1;
      visibility: visible;
      translate: none;
      transition:
        opacity 250ms ease,
        translate 250ms ease;
    }

    nav a {
      padding: 0.95rem 0;
      font-size: 0.85rem;
      background: none;
    }

    nav a + a {
      border-top: 1px solid var(--filet-pale);
    }

    nav a:hover {
      background: none;
    }

    /* Sans JavaScript, le menu reste affiché en dessous */
    :global(html:not(.js)) nav {
      position: static;
      opacity: 1;
      visibility: visible;
      translate: none;
    }
  }

  @media (max-width: 26rem) {
    .menu-libelle {
      display: none;
    }

    .outils-entete {
      padding-left: 0.6rem;
    }
  }

  .pied {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding-top: 3.5rem;
    padding-bottom: 3rem;
    font-size: 0.75rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gris-or);
  }

  .losange {
    width: 5px;
    height: 5px;
    background: var(--or);
    transform: rotate(45deg);
  }
</style>
